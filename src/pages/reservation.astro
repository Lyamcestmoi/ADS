  .availability-dialog { width: min(760px, calc(100% - 32px)); max-height: calc(100dvh - 32px); padding: 0; border: 0; background: var(--paper); color: var(--ink); box-shadow: 0 28px 90px rgba(8, 35, 31, .35); }
  .availability-dialog::backdrop { background: rgba(7, 29, 26, .72); backdrop-filter: blur(5px); }
  .availability-dialog-header { display: flex; justify-content: space-between; gap: 24px; align-items: center; padding: 22px 24px 12px; }
  .availability-dialog-header h2 { margin: 0; color: var(--forest-900); font-size: clamp(28px, 4vw, 40px); font-weight: 600; letter-spacing: -.045em; line-height: 1; }
  .availability-dialog-header button { display: grid; flex: 0 0 auto; place-items: center; width: 46px; height: 46px; border: 1px solid var(--line); background: var(--white); color: var(--forest-900); cursor: pointer; }
