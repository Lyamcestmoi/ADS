---
import { ArrowLeft, CalendarDays, Check, Info, Mail } from '@lucide/astro';
import MainLayout from '../layouts/MainLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';

const title = 'Demande de réservation — Stand ADS Prêles';
const description =
  'Préparez votre demande de réservation pour le Stand ADS à Prêles.';
---

<MainLayout title={title} description={description}>
  <SiteHeader active="reservation" />

  <main class="reservation-page">
    <section class="reservation-hero">
      <div class="reservation-shell reservation-hero-grid">
        <div>
          <a class="back-link" href="/">
            <ArrowLeft size={16} stroke-width={1.8} aria-hidden="true" />
            Retour au stand
          </a>
          <p class="reservation-eyebrow">Votre événement à Prêles</p>
          <h1>Préparons votre réservation.</h1>
          <p class="reservation-lead">
            Indiquez-nous les grandes lignes de votre projet. La gérance vérifie
            ensuite la disponibilité et vous confirme le montant définitif.
          </p>
        </div>

        <ol class="reservation-steps" aria-label="Étapes de la réservation">
          <li><span>01</span><strong>Choisissez votre formule</strong></li>
          <li><span>02</span><strong>Ajoutez vos informations</strong></li>
          <li><span>03</span><strong>Recevez une confirmation</strong></li>
        </ol>
      </div>
    </section>

    <section class="reservation-content">
      <div class="reservation-shell reservation-layout">
        <form id="reservation-form" class="form-panel">
          <div class="notice" role="status">
            <Info size={20} stroke-width={1.8} aria-hidden="true" />
            <div>
              <strong>Le formulaire est en préparation</strong>
              <span>Aucune donnée n’est envoyée actuellement. Vous pouvez nous écrire par e-mail.</span>
            </div>
          </div>

          <fieldset>
            <legend><span>01</span> Votre événement</legend>
            <div class="form-grid">
              <label class="full">
                <span>Type de location *</span>
                <select name="tarif" required>
                  <option value="">Choisir une formule</option>
                  <option>Journée ou soirée, lundi–jeudi — CHF 90.–</option>
                  <option>Jour complet, lundi–jeudi — CHF 150.–</option>
                  <option>Jour complet, week-end ou férié — CHF 190.–</option>
                  <option>3 jours consécutifs ou plus — CHF 120.– / jour</option>
                </select>
              </label>

              <label>
                <span>Date de début *</span>
                <input name="date_debut" type="date" required />
              </label>

              <label>
                <span>Date de fin</span>
                <input name="date_fin" type="date" />
              </label>

              <label>
                <span>Nombre de personnes *</span>
                <input
                  name="participants"
                  type="number"
                  min="1"
                  max="65"
                  placeholder="Ex. 45"
                  required
                />
              </label>

              <label class="check-row">
                <input name="membre_ads" type="checkbox" />
                <span>Membre ADS <small>réduction de 20 %</small></span>
              </label>
            </div>
          </fieldset>

          <fieldset>
            <legend><span>02</span> Options</legend>
            <div class="option-grid">
              <label class="option-card">
                <input name="four_pizza" type="checkbox" />
                <span><strong>Four à pizza</strong><small>+ CHF 50.–</small></span>
                <Check size={18} stroke-width={2} aria-hidden="true" />
              </label>
              <label class="option-card">
                <input name="bois" type="checkbox" />
                <span><strong>Bois supplémentaire</strong><small>+ CHF 30.–</small></span>
                <Check size={18} stroke-width={2} aria-hidden="true" />
              </label>
            </div>
          </fieldset>

          <fieldset>
            <legend><span>03</span> Vos coordonnées</legend>
            <div class="form-grid">
              <label>
                <span>Prénom *</span>
                <input name="prenom" autocomplete="given-name" required />
              </label>
              <label>
                <span>Nom *</span>
                <input name="nom" autocomplete="family-name" required />
              </label>
              <label>
                <span>Téléphone *</span>
                <input
                  name="telephone"
                  type="tel"
                  autocomplete="tel"
                  placeholder="079 123 45 67"
                  required
                />
              </label>
              <label>
                <span>E-mail *</span>
                <input
                  name="email"
                  type="email"
                  autocomplete="email"
                  placeholder="nom@exemple.ch"
                  required
                />
              </label>
              <label class="full">
                <span>Remarques</span>
                <textarea
                  name="remarques"
                  rows="5"
                  placeholder="Informations utiles concernant votre événement…"
                ></textarea>
              </label>
            </div>
          </fieldset>

          <label class="consent-row">
            <input type="checkbox" required />
            <span>Je comprends qu’il s’agit d’une demande et non d’une confirmation.</span>
          </label>

          <button class="submit-button" type="button" disabled>
            Envoi en ligne bientôt disponible
          </button>

          <p class="fallback">
            Pour réserver dès maintenant :
            <a href="mailto:gerante@ads-preles.ch">gerante@ads-preles.ch</a>
          </p>
        </form>

        <aside class="summary-panel">
          <div>
            <p class="reservation-eyebrow">Repères</p>
            <h2>Les tarifs en un coup d’œil.</h2>
          </div>
          <dl>
            <div><dt>Lun–jeu · journée/soirée</dt><dd>CHF 90.–</dd></div>
            <div><dt>Lun–jeu · jour complet</dt><dd>CHF 150.–</dd></div>
            <div><dt>Week-end ou férié</dt><dd>CHF 190.–</dd></div>
            <div><dt>Dès 3 jours · par jour</dt><dd>CHF 120.–</dd></div>
          </dl>
          <ul>
            <li><Check size={16} stroke-width={2} aria-hidden="true" /> Réduction membre ADS de 20 %</li>
            <li><Check size={16} stroke-width={2} aria-hidden="true" /> Caution non-membre de CHF 150.–</li>
            <li><CalendarDays size={16} stroke-width={1.8} aria-hidden="true" /> Disponibilité confirmée par la gérance</li>
          </ul>
          <a class="summary-contact" href="mailto:gerante@ads-preles.ch">
            <Mail size={18} stroke-width={1.8} aria-hidden="true" />
            Écrire à la gérance
          </a>
        </aside>
      </div>
    </section>
  </main>

  <SiteFooter />
</MainLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('#reservation-form');
  const start = document.querySelector<HTMLInputElement>('[name="date_debut"]');
  const end = document.querySelector<HTMLInputElement>('[name="date_fin"]');
  const now = new Date();
  const today = [
    now.getFullYear(),
    String(now.getMonth() + 1).padStart(2, '0'),
    String(now.getDate()).padStart(2, '0'),
  ].join('-');

  form?.addEventListener('submit', (event) => event.preventDefault());

  if (start) start.min = today;
  if (end) end.min = today;

  start?.addEventListener('change', () => {
    if (!end) return;
    end.min = start.value || today;
    if (end.value && end.value < end.min) end.value = '';
  });
</script>

<style>
  .reservation-page {
    background: var(--cream);
  }

  .reservation-shell {
    width: var(--shell);
    margin-inline: auto;
  }

  .reservation-hero {
    padding: 90px 0 86px;
    background: var(--forest-950);
    color: var(--white);
  }

  .reservation-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(320px, 0.75fr);
    gap: 90px;
    align-items: end;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 62px;
    color: rgba(255, 255, 255, 0.62);
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
  }

  .back-link:hover {
    color: var(--yellow);
  }

  .reservation-eyebrow {
    margin: 0 0 16px;
    color: var(--yellow);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 760px;
    margin: 0;
    font-size: clamp(54px, 7vw, 92px);
    font-weight: 500;
    letter-spacing: -0.06em;
    line-height: 0.94;
  }

  .reservation-lead {
    max-width: 650px;
    margin: 28px 0 0;
    color: rgba(255, 255, 255, 0.7);
    font-size: 18px;
  }

  .reservation-steps {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .reservation-steps li {
    display: grid;
    grid-template-columns: 42px 1fr;
    gap: 15px;
    align-items: center;
    min-height: 66px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
  }

  .reservation-steps span {
    color: var(--yellow);
    font-size: 11px;
    font-weight: 800;
  }

  .reservation-steps strong {
    font-size: 14px;
  }

  .reservation-content {
    padding: 76px 0 110px;
  }

  .reservation-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 360px;
    gap: 28px;
    align-items: start;
  }

  .form-panel {
    padding: clamp(24px, 4vw, 48px);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--paper);
  }

  .notice {
    display: flex;
    gap: 14px;
    margin-bottom: 48px;
    padding: 18px 20px;
    border: 1px solid #dec456;
    border-radius: var(--radius-sm);
    background: #fbf1bd;
    color: #554807;
  }

  .notice svg {
    flex: 0 0 auto;
    margin-top: 2px;
  }

  .notice div,
  .notice strong,
  .notice span {
    display: block;
  }

  .notice span {
    margin-top: 2px;
    font-size: 13px;
  }

  fieldset {
    margin: 0 0 48px;
    padding: 0;
    border: 0;
  }

  legend {
    width: 100%;
    margin-bottom: 24px;
    padding-bottom: 15px;
    border-bottom: 1px solid var(--line);
    color: var(--forest-900);
    font-size: 22px;
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  legend span {
    margin-right: 12px;
    color: var(--blue);
    font-size: 11px;
    letter-spacing: 0.08em;
  }

  .form-grid,
  .option-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  label:not(.check-row, .option-card, .consent-row) {
    display: grid;
    gap: 8px;
  }

  label > span {
    font-size: 13px;
    font-weight: 800;
  }

  .full {
    grid-column: 1 / -1;
  }

  input,
  select,
  textarea {
    width: 100%;
    min-height: 50px;
    padding: 12px 14px;
    border: 1px solid var(--line);
    border-radius: 8px;
    outline: 0;
    background: var(--white);
    color: var(--ink);
  }

  textarea {
    resize: vertical;
  }

  input:focus,
  select:focus,
  textarea:focus {
    border-color: var(--blue);
    box-shadow: 0 0 0 3px rgba(17, 135, 178, 0.12);
  }

  .check-row,
  .option-card,
  .consent-row {
    display: flex;
    gap: 12px;
    align-items: center;
  }

  .check-row {
    align-self: end;
    min-height: 50px;
    padding: 11px 14px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--white);
  }

  .check-row input,
  .option-card input,
  .consent-row input {
    width: 18px;
    min-height: 18px;
    margin: 0;
    accent-color: var(--blue);
  }

  .check-row span,
  .check-row small {
    display: block;
  }

  .check-row small {
    color: var(--muted);
    font-weight: 500;
  }

  .option-card {
    position: relative;
    min-height: 86px;
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--white);
    cursor: pointer;
  }

  .option-card span {
    display: grid;
    margin-right: auto;
  }

  .option-card small {
    color: var(--muted);
    font-weight: 500;
  }

  .option-card > svg {
    opacity: 0;
    color: var(--blue);
  }

  .option-card:has(input:checked) {
    border-color: var(--blue);
    background: var(--blue-soft);
  }

  .option-card:has(input:checked) > svg {
    opacity: 1;
  }

  .consent-row {
    align-items: flex-start;
    margin-bottom: 18px;
    padding: 17px;
    border-radius: var(--radius-sm);
    background: var(--forest-100);
  }

  .consent-row input {
    flex: 0 0 auto;
    margin-top: 3px;
  }

  .submit-button {
    width: 100%;
    min-height: 54px;
    border: 0;
    border-radius: 999px;
    background: #bdc6c3;
    color: var(--white);
    font-weight: 800;
    cursor: not-allowed;
  }

  .fallback {
    margin: 16px 0 0;
    color: var(--muted);
    font-size: 13px;
    text-align: center;
  }

  .fallback a {
    color: var(--forest-900);
    font-weight: 800;
  }

  .summary-panel {
    position: sticky;
    top: 110px;
    padding: 34px;
    border-radius: var(--radius);
    background: var(--forest-900);
    color: var(--white);
  }

  .summary-panel h2 {
    margin: 0 0 28px;
    font-size: 34px;
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 1.05;
  }

  .summary-panel dl {
    margin: 0;
  }

  .summary-panel dl div {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 14px;
    padding: 15px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
  }

  .summary-panel dt,
  .summary-panel dd {
    margin: 0;
    font-size: 13px;
  }

  .summary-panel dt {
    color: rgba(255, 255, 255, 0.64);
  }

  .summary-panel dd {
    color: var(--yellow);
    font-weight: 800;
    white-space: nowrap;
  }

  .summary-panel ul {
    display: grid;
    gap: 12px;
    margin: 28px 0;
    padding: 0;
    list-style: none;
  }

  .summary-panel li {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    color: rgba(255, 255, 255, 0.72);
    font-size: 12px;
  }

  .summary-panel li svg {
    flex: 0 0 auto;
    color: var(--yellow);
  }

  .summary-contact {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    min-height: 50px;
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: 999px;
    color: var(--white);
    font-size: 13px;
    font-weight: 800;
    text-decoration: none;
  }

  .summary-contact:hover {
    border-color: var(--yellow);
    color: var(--yellow);
  }

  @media (max-width: 960px) {
    .reservation-hero-grid,
    .reservation-layout {
      grid-template-columns: 1fr;
    }

    .reservation-hero-grid {
      gap: 46px;
    }

    .back-link {
      margin-bottom: 44px;
    }

    .reservation-steps {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }

    .reservation-steps li {
      grid-template-columns: 1fr;
      gap: 5px;
      align-content: start;
      border-bottom: 0;
    }

    .summary-panel {
      position: static;
      grid-row: 1;
    }
  }

  @media (max-width: 640px) {
    .reservation-hero {
      padding: 54px 0 58px;
    }

    .reservation-steps {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .reservation-steps li {
      grid-template-columns: 38px 1fr;
      min-height: 52px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.14);
    }

    .reservation-content {
      padding: 28px 0 70px;
    }

    .form-grid,
    .option-grid {
      grid-template-columns: 1fr;
    }

    .full {
      grid-column: auto;
    }

    .notice {
      margin-bottom: 36px;
    }

    fieldset {
      margin-bottom: 38px;
    }
  }
</style>
