  .availability-dialog-footer small { display: block; margin-top: 3px; }
  .availability-dialog-footer a { flex: 0 0 auto; color: var(--blue); font-size: 13px; font-weight: 800; }

  .progress { position: sticky; top: 82px; z-index: 50; border-bottom: 1px solid var(--line); background: var(--white); }
  .progress-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .progress-step { display: flex; align-items: center; gap: 10px; min-width: 0; min-height: 60px; padding: 12px 0; border: 0; border-bottom: 3px solid transparent; background: transparent; color: var(--muted); text-align: left; cursor: pointer; }
  .progress-step span { font-size: 14px; font-weight: 600; }
  .progress-step strong { font-size: 15px; font-weight: 600; line-height: 1.4; }
  .progress-step.active { border-bottom-color: var(--forest-900); color: var(--forest-900); }
  .progress-step.active span { color: var(--forest-900); }
  .progress-step.done { color: var(--forest-900); }
