---
import MainLayout from '../layouts/MainLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';

const title = 'Demande de réservation — Stand ADS Prêles';
const description =
  'Préparez votre demande de réservation pour le Stand ADS à Prêles.';
---

<MainLayout title={title} description={description}>
  <SiteHeader active="reservation" />

  <main>
    <section class="hero-reservation">
      <div class="container">
        <p class="eyebrow">Location du Stand ADS</p>
        <h1>Demande de réservation</h1>
        <p>
          La disponibilité et le montant définitif sont confirmés par la gérance
          avant tout paiement.
        </p>
      </div>
    </section>

    <section class="content">
      <div class="container layout">
        <form id="reservation-form" class="card">
          <div class="notice" role="status">
            <strong>Envoi en ligne bientôt disponible</strong>
            <span>Aucune donnée n’est envoyée pour le moment.</span>
          </div>

          <fieldset>
            <legend>1. Votre événement</legend>

            <div class="grid">
              <label class="full">
                Type de location *

                <select name="tarif" required>
                  <option value="">Choisir une formule</option>
                  <option>Journée ou soirée, lundi–jeudi — CHF 90.–</option>
                  <option>Jour complet, lundi–jeudi — CHF 150.–</option>
                  <option>Jour complet, week-end ou férié — CHF 190.–</option>
                  <option>3 jours consécutifs ou plus — CHF 120.– / jour</option>
                </select>
              </label>

              <label>
                Date de début *
                <input name="date_debut" type="date" required />
              </label>

              <label>
                Date de fin
                <input name="date_fin" type="date" />
              </label>

              <label>
                Nombre de personnes *

                <input
                  name="participants"
                  type="number"
                  min="1"
                  max="70"
                  placeholder="Ex. 45"
                  required
                />
              </label>

              <label class="check">
                <input name="membre_ads" type="checkbox" />
                Membre ADS (réduction de 20 %)
              </label>
            </div>
          </fieldset>

          <fieldset>
            <legend>2. Options</legend>

            <div class="options">
              <label class="option">
                <input name="four_pizza" type="checkbox" />

                <span>
                  <strong>Four à pizza</strong>
                  <small>+ CHF 50.–</small>
                </span>
              </label>

              <label class="option">
                <input name="bois" type="checkbox" />

                <span>
                  <strong>Bois supplémentaire</strong>
                  <small>+ CHF 30.–</small>
                </span>
              </label>
            </div>
          </fieldset>

          <fieldset>
            <legend>3. Vos coordonnées</legend>

            <div class="grid">
              <label>
                Prénom *
                <input name="prenom" autocomplete="given-name" required />
              </label>

              <label>
                Nom *
                <input name="nom" autocomplete="family-name" required />
              </label>

              <label>
                Téléphone *

                <input
                  name="telephone"
                  type="tel"
                  autocomplete="tel"
                  placeholder="079 123 45 67"
                  required
                />
              </label>

              <label>
                E-mail *

                <input
                  name="email"
                  type="email"
                  autocomplete="email"
                  placeholder="nom@exemple.ch"
                  required
                />
              </label>

              <label class="full">
                Remarques

                <textarea
                  name="remarques"
                  rows="5"
                  placeholder="Informations utiles concernant votre événement…"
                ></textarea>
              </label>
            </div>
          </fieldset>

          <label class="consent">
            <input type="checkbox" required />
            Je comprends qu’il s’agit d’une demande et non d’une confirmation.
          </label>

          <button type="button" disabled>
            Envoi en ligne bientôt disponible
          </button>

          <p class="fallback">
            Pour réserver maintenant :
            <a href="mailto:gerante@ads-preles.ch">
              gerante@ads-preles.ch
            </a>
          </p>
        </form>

        <aside class="card summary">
          <p class="eyebrow">Informations</p>
          <h2>Tarifs principaux</h2>

          <ul>
            <li>
              <span>Lun–jeu, journée/soirée</span>
              <strong>CHF 90.–</strong>
            </li>

            <li>
              <span>Lun–jeu, jour complet</span>
              <strong>CHF 150.–</strong>
            </li>

            <li>
              <span>Week-end ou férié</span>
              <strong>CHF 190.–</strong>
            </li>

            <li>
              <span>Dès 3 jours, par jour</span>
              <strong>CHF 120.–</strong>
            </li>
          </ul>

          <p class="note">
            Caution non-membre : CHF 150.–. Le tarif final et les informations
            de paiement sont communiqués après vérification de la disponibilité.
          </p>
        </aside>
      </div>
    </section>
  </main>

  <SiteFooter />
</MainLayout>

<script>
  const form =
    document.querySelector<HTMLFormElement>('#reservation-form');

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
  });

  const today = new Date().toISOString().split('T')[0];

  document
    .querySelectorAll<HTMLInputElement>('input[type="date"]')
    .forEach((input) => {
      input.min = today;
    });
</script>

<style>
  .container {
    width: min(1100px, calc(100% - 40px));
    margin: 0 auto;
  }

  .hero-reservation {
    padding: 70px 0;
    color: white;
    background:
      linear-gradient(
        120deg,
        rgba(43, 80, 56, 0.96),
        rgba(58, 107, 74, 0.78)
      ),
      url('/stand.png') center 55% / cover;
  }

  .eyebrow {
    color: var(--green-mid);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.4px;
    text-transform: uppercase;
  }

  h1 {
    margin: 8px 0 14px;
    font-family: 'Playfair Display', serif;
    font-size: clamp(38px, 6vw, 58px);
    line-height: 1.08;
  }

  .hero-reservation p:last-child {
    max-width: 650px;
    color: rgba(255, 255, 255, 0.86);
    font-size: 18px;
  }

  .content {
    padding: 55px 0 80px;
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 310px;
    gap: 28px;
    align-items: start;
  }

  .card {
    padding: 30px;
    border: 1px solid var(--gray-l);
    border-radius: 14px;
    background: white;
    box-shadow: var(--shadow);
  }

  .notice {
    display: grid;
    gap: 3px;
    margin-bottom: 30px;
    padding: 15px 17px;
    border: 1px solid #e8cf8f;
    border-radius: 9px;
    background: #fff8e7;
    color: #6d5520;
  }

  fieldset {
    margin: 0 0 32px;
    padding: 0;
    border: 0;
  }

  legend {
    width: 100%;
    margin-bottom: 18px;
    padding-bottom: 9px;
    border-bottom: 2px solid var(--green-light);
    color: var(--green-dark);
    font-family: 'Playfair Display', serif;
    font-size: 22px;
    font-weight: 700;
  }

  .grid,
  .options {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  label {
    display: grid;
    gap: 7px;
    font-size: 14px;
    font-weight: 700;
  }

  .full {
    grid-column: 1 / -1;
  }

  input,
  select,
  textarea {
    width: 100%;
    padding: 12px 13px;
    border: 1px solid var(--gray);
    border-radius: 7px;
    background: white;
    color: var(--ink);
    font: inherit;
  }

  input:focus,
  select:focus,
  textarea:focus {
    border-color: var(--green);
    outline: 3px solid rgba(58, 107, 74, 0.12);
  }

  .check,
  .option,
  .consent {
    display: flex;
    gap: 10px;
    align-items: flex-start;
  }

  .check {
    align-self: end;
    padding-bottom: 12px;
  }

  .check input,
  .option input,
  .consent input {
    width: auto;
    margin-top: 4px;
    accent-color: var(--green);
  }

  .option {
    padding: 15px;
    border: 1px solid var(--gray-l);
    border-radius: 9px;
    background: var(--off);
  }

  .option span {
    display: grid;
  }

  .option small {
    color: var(--gray-d);
    font-weight: 400;
  }

  .consent {
    margin-bottom: 18px;
    padding: 15px;
    border-radius: 9px;
    background: var(--green-light);
  }

  button {
    width: 100%;
    padding: 14px;
    border: 0;
    border-radius: 7px;
    background: var(--gray);
    color: white;
    font: inherit;
    font-weight: 700;
    cursor: not-allowed;
  }

  .fallback {
    margin-top: 15px;
    color: var(--gray-d);
    font-size: 14px;
    text-align: center;
  }

  .fallback a {
    color: var(--green-dark);
    font-weight: 700;
  }

  .summary {
    position: sticky;
    top: 88px;
  }

  .summary h2 {
    margin: 5px 0 18px;
    font-family: 'Playfair Display', serif;
    font-size: 25px;
  }

  .summary li {
    display: flex;
    justify-content: space-between;
    gap: 15px;
    padding: 11px 0;
    border-bottom: 1px solid var(--gray-l);
    list-style: none;
  }

  .summary li span {
    color: var(--gray-d);
  }

  .summary li strong {
    white-space: nowrap;
  }

  .note {
    margin-top: 18px;
    color: var(--gray-d);
    font-size: 13px;
  }

  @media (max-width: 820px) {
    .layout {
      grid-template-columns: 1fr;
    }

    .summary {
      position: static;
      grid-row: 1;
    }
  }

  @media (max-width: 600px) {
    .container {
      width: min(100% - 24px, 1100px);
    }

    .hero-reservation {
      padding: 48px 0;
    }

    .content {
      padding: 30px 0 55px;
    }

    .card {
      padding: 20px;
    }

    .grid,
    .options {
      grid-template-columns: 1fr;
    }

    .full {
      grid-column: auto;
    }
  }
</style>