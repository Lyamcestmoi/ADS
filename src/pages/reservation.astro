---
import {
  ArrowLeft, CalendarDays, Check, ChevronLeft, ChevronRight,
  CircleDollarSign, Flame, Info, KeyRound, Mail, Phone, Pizza,
  Printer, RotateCcw, ShieldCheck, Sparkles, UserRound, Users,
} from '@lucide/astro';
import MainLayout from '../layouts/MainLayout.astro';
import AvailabilityCalendar from '../components/AvailabilityCalendar.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { getAvailability, googleCalendarUrl } from '../lib/availability';

const title = 'Contrat de réservation — Stand ADS Prêles';
const description =
  'Formulaire et contrat de location du Stand ADS à Prêles.';

const availability = await getAvailability();
const syncedLabel = availability.syncedAt
  ? new Intl.DateTimeFormat('fr-CH', {
      dateStyle: 'short',
      timeStyle: 'short',
      timeZone: 'Europe/Zurich',
    }).format(new Date(availability.syncedAt))
  : null;

const rentalConditions = [
  {
    title: 'Durée et tarifs',
    text: 'Un jour complet correspond à environ 23 h, de 10 h à 9 h le lendemain. Les jours fériés sont facturés comme le week-end.',
  },
  {
    title: 'Conditions hivernales',
    text: 'Le déneigement éventuel est à la charge du locataire. Par grand froid, l’eau peut être coupée et les WC mis hors service.',
  },
  {
    title: 'Déchets et brasero',
    text: 'Les grillades sont interdites à l’intérieur et autorisées uniquement au braséro / à la cheminée extérieure. L’évacuation des déchets et le nettoyage du braséro sont à la charge du locataire.',
  },
  {
    title: 'Utilisation du stand',
    text: 'La sous-location est interdite. Les membres ADS bénéficient d’une réduction de 20 % sur la location.',
  },
  {
    title: 'Annulation',
    text: 'Dans le mois précédant la location, 50 % du montant versé est retenu à titre de dédommagement.',
  },
  {
    title: 'Responsabilité',
    text: 'L’ADS décline toute responsabilité en cas d’incendie, vol ou accident. Le locataire confirme disposer d’une assurance RC.',
  },
  {
    title: 'Paiement',
    text: 'Après acceptation de la demande, la gérance transmet les coordonnées bancaires et le délai de paiement. La réservation est confirmée après réception du paiement.',
  },
  {
    title: 'Respect du site',
    text: 'Le locataire s’engage à préserver la nature et les activités agricoles et forestières, puis à remettre les lieux dans leur état initial.',
  },
];
---

<MainLayout title={title} description={description}>
  <SiteHeader active="reservation" />

  <main class="booking-page">
    <section class="booking-hero">
      <div class="reservation-shell booking-hero-grid">
        <div>
          <a class="back-link" href="/">
            <ArrowLeft size={17} stroke-width={1.8} aria-hidden="true" />
            Retour au stand
          </a>
          <p class="booking-eyebrow">Contrat de location</p>
          <h1>Réserver le Stand ADS.</h1>
        </div>
        <p class="booking-lead">
          Remplissez le formulaire. À la fin, vous pourrez enregistrer le contrat
          en PDF et l’envoyer à la gérance.
        </p>
      </div>
    </section>

    <section class="availability-section" aria-labelledby="availability-title">
      <div class="reservation-shell">
        <div class="availability-heading">
          <div>
            <p class="booking-eyebrow">Disponibilités</p>
            <h2 id="availability-title">Consulter l’agenda</h2>
          </div>
          <p>Choisissez une date libre : elle sera automatiquement reportée dans le formulaire.</p>
        </div>

        <div class="availability-layout">
          <div class="availability-calendar-panel">
            <AvailabilityCalendar
              bookedDates={availability.bookedDates}
              available={availability.available}
            />
          </div>

          <aside class="availability-guide" aria-label="Comment effectuer une demande">
            <div>
              <p class="booking-eyebrow">Comment réserver</p>
              <h3>Une demande en trois étapes</h3>
            </div>
            <ol>
              <li><span>01</span><p><strong>Choisissez une date libre</strong> dans le calendrier.</p></li>
              <li><span>02</span><p><strong>Complétez le formulaire</strong> et vérifiez le tarif calculé.</p></li>
              <li><span>03</span><p><strong>Enregistrez le contrat en PDF</strong> puis envoyez-le à la gérance.</p></li>
            </ol>
            <div class="availability-note" role="note">
              <Info size={20} stroke-width={1.8} aria-hidden="true" />
              <p>
                La demande devient définitive après confirmation de la gérance
                et réception du paiement.
                {syncedLabel && <small>Agenda mis à jour le {syncedLabel}.</small>}
              </p>
              <a href={googleCalendarUrl} target="_blank" rel="noopener noreferrer">
                Ouvrir l’agenda Google
              </a>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <nav class="progress" aria-label="Progression de la réservation">
      <div class="reservation-shell progress-grid">
        <button class="progress-step active" type="button" data-go-step="0" aria-current="step"><span>01</span><strong>Date & période</strong></button>
        <button class="progress-step" type="button" data-go-step="1"><span>02</span><strong>Options</strong></button>
        <button class="progress-step" type="button" data-go-step="2"><span>03</span><strong>Coordonnées</strong></button>
        <button class="progress-step" type="button" data-go-step="3"><span>04</span><strong>Conditions</strong></button>
        <button class="progress-step" type="button" data-go-step="4"><span>05</span><strong>Récapitulatif</strong></button>
      </div>
    </nav>

    <section class="booking-content">
      <div class="reservation-shell booking-layout">
        <form id="booking-form" class="form-card" novalidate>
          <div class="privacy-note" role="note">
            <ShieldCheck size={22} stroke-width={1.8} aria-hidden="true" />
            <div>
              <strong>Vos données restent dans votre navigateur</strong>
              <span>Aucune donnée n’est envoyée par ce site. Vous devrez enregistrer le contrat en PDF et l’envoyer vous-même à la gérance.</span>
            </div>
          </div>

          <section class="form-step active" data-step="0" aria-labelledby="step-title-0">
            <header class="step-header">
              <span class="step-number">01</span>
              <div><h2 id="step-title-0">Date & période</h2><p>Après avoir consulté l’agenda ci-dessus, indiquez la date, la durée et le nombre de personnes.</p></div>
            </header>

            <div class="field-grid two-cols">
              <label class="field">
                <span>Date de début *</span>
                <input id="date-field" name="date" type="date" required />
                <small id="date-availability-feedback">Sélectionnez une date verte dans le calendrier ou saisissez-la ici.</small>
              </label>
              <label class="check-card holiday-card">
                <input id="holiday-field" name="jour_ferie" type="checkbox" />
                <span><strong>Jour férié</strong><small>Applique le tarif week-end</small></span>
              </label>
            </div>

            <fieldset class="plain-fieldset">
              <legend>Période souhaitée *</legend>
              <div class="period-grid">
                <button class="period-card" type="button" data-period="journee">
                  <CalendarDays size={22} stroke-width={1.7} aria-hidden="true" />
                  <strong>Journée</strong><span>10 h → 17 h</span><b data-price="journee">CHF 90.–</b>
                </button>
                <button class="period-card" type="button" data-period="soiree">
                  <Sparkles size={22} stroke-width={1.7} aria-hidden="true" />
                  <strong>Soirée</strong><span>18 h → 9 h</span><b data-price="soiree">CHF 90.–</b>
                </button>
                <button class="period-card" type="button" data-period="complet">
                  <CircleDollarSign size={22} stroke-width={1.7} aria-hidden="true" />
                  <strong>Jour complet</strong><span>10 h → 9 h · environ 23 h</span><b data-price="complet">CHF 150.–</b>
                </button>
                <button class="period-card" type="button" data-period="consecutif">
                  <CalendarDays size={22} stroke-width={1.7} aria-hidden="true" />
                  <strong>3 jours consécutifs ou plus</strong><span>Tarif calculé par jour</span><b data-price="consecutif">CHF 160.– / jour</b>
                </button>
              </div>
              <p class="field-hint">Le week-end et les jours fériés, seules les formules « jour complet » et « 3 jours ou plus » sont proposées.</p>
            </fieldset>

            <div id="days-group" class="field hidden">
              <label for="days-field">Nombre de jours consécutifs *</label>
              <input id="days-field" name="nombre_jours" type="number" min="3" max="30" value="3" />
            </div>

            <div class="participants-row">
              <div class="field">
                <label for="people-field">Nombre de personnes *</label>
                <div class="counter">
                  <button type="button" data-counter="-1" aria-label="Retirer une personne">−</button>
                  <input id="people-field" name="participants" type="number" min="1" max="70" value="20" required />
                  <button type="button" data-counter="1" aria-label="Ajouter une personne">+</button>
                </div>
              </div>
              <div class="capacity-note"><Users size={22} stroke-width={1.7} aria-hidden="true" /><span><strong>70 places assises</strong> · capacité maximale de 70 personnes</span></div>
            </div>

            <p class="step-error" data-error-step="0" role="alert"></p>
            <div class="step-actions end"><button class="action primary" type="button" data-next-step>Continuer <ChevronRight size={18} aria-hidden="true" /></button></div>
          </section>

          <section class="form-step" data-step="1" aria-labelledby="step-title-1">
            <header class="step-header">
              <span class="step-number">02</span>
              <div><h2 id="step-title-1">Options & services</h2><p>Sélectionnez les options dont vous avez besoin.</p></div>
            </header>

            <div class="option-list">
              <label class="option-row member-option">
                <input id="member-field" name="membre_ads" type="checkbox" />
                <span class="option-icon"><UserRound size={22} stroke-width={1.8} /></span>
                <span class="option-copy"><strong>Membre ADS</strong><small>Réduction de 20 % sur la location de base</small></span>
                <b>−20 %</b><span class="option-check"><Check size={17} /></span>
              </label>
              <div id="caution-row" class="option-row automatic-option applied" role="status" aria-live="polite">
                <span class="option-icon"><KeyRound size={22} stroke-width={1.8} /></span>
                <span class="option-copy"><strong>Caution non-membre</strong><small>Appliquée automatiquement et remboursée si tout est en ordre</small></span>
                <b id="caution-status">+ CHF 150.–</b><span class="option-check"><Check size={17} /></span>
              </div>
              <label class="option-row">
                <input id="pizza-field" name="four_pizza" type="checkbox" />
                <span class="option-icon"><Pizza size={22} stroke-width={1.8} /></span>
                <span class="option-copy"><strong>Four à pizza</strong><small>Demi-caddie de bois supplémentaire inclus</small></span>
                <b>+ CHF 50.–</b><span class="option-check"><Check size={17} /></span>
              </label>
              <label class="option-row">
                <input id="wood-field" name="bois" type="checkbox" />
                <span class="option-icon"><Flame size={22} stroke-width={1.8} /></span>
                <span class="option-copy"><strong>Bois supplémentaire</strong><small>Pour la période hivernale</small></span>
                <b>+ CHF 30.–</b><span class="option-check"><Check size={17} /></span>
              </label>
              <label class="option-row">
                <input id="cleaning-field" name="nettoyage_locataire" type="checkbox" checked />
                <span class="option-icon"><Sparkles size={22} stroke-width={1.8} /></span>
                <span class="option-copy"><strong>Nettoyage par le locataire</strong><small>Sinon, CHF 50.–/h seront facturés par la gérance</small></span>
                <b>Inclus</b><span class="option-check"><Check size={17} /></span>
              </label>
            </div>

            <div class="included-note"><Info size={20} stroke-width={1.8} aria-hidden="true" /><span><strong>Inclus :</strong> un caddie de bois, eau, électricité, cuisine équipée, cheminée intérieure sans grillades, places assises et vaisselle.</span></div>
            <div class="step-actions">
              <button class="action secondary" type="button" data-prev-step><ChevronLeft size={18} aria-hidden="true" /> Retour</button>
              <button class="action primary" type="button" data-next-step>Continuer <ChevronRight size={18} aria-hidden="true" /></button>
            </div>
          </section>

          <section class="form-step" data-step="2" aria-labelledby="step-title-2">
            <header class="step-header">
              <span class="step-number">03</span>
              <div><h2 id="step-title-2">Coordonnées du locataire</h2><p>Indiquez les coordonnées de la personne responsable du contrat.</p></div>
            </header>

            <div class="field-grid two-cols">
              <label class="field"><span>Prénom *</span><input id="first-name" name="prenom" autocomplete="given-name" required /></label>
              <label class="field"><span>Nom *</span><input id="last-name" name="nom" autocomplete="family-name" required /></label>
              <label class="field full"><span>Adresse *</span><input id="address-field" name="adresse" autocomplete="street-address" required /></label>
              <label class="field postal-field"><span>Code postal *</span><input id="postal-field" name="npa" inputmode="numeric" autocomplete="postal-code" maxlength="6" required /></label>
              <label class="field"><span>Localité *</span><input id="city-field" name="localite" autocomplete="address-level2" required /></label>
              <label class="field"><span>Téléphone *</span><input id="phone-field" name="telephone" type="tel" autocomplete="tel" required /></label>
              <label class="field"><span>Adresse e-mail</span><input id="email-field" name="email" type="email" autocomplete="email" /></label>
              <label class="field full">
                <span>IBAN pour la restitution de la caution</span>
                <input id="client-iban" name="iban_client" inputmode="text" autocomplete="off" placeholder="CH00 0000 0000 0000 0000 0" />
                <small id="iban-help">Obligatoire pour les non-membres afin de permettre le remboursement de la caution.</small>
              </label>
              <label class="field full"><span>Remarques</span><textarea id="remarks-field" name="remarques" rows="4"></textarea></label>
            </div>

            <p class="step-error" data-error-step="2" role="alert"></p>
            <div class="step-actions">
              <button class="action secondary" type="button" data-prev-step><ChevronLeft size={18} aria-hidden="true" /> Retour</button>
              <button class="action primary" type="button" data-next-step>Continuer <ChevronRight size={18} aria-hidden="true" /></button>
            </div>
          </section>

          <section class="form-step" data-step="3" aria-labelledby="step-title-3">
            <header class="step-header">
              <span class="step-number">04</span>
              <div><h2 id="step-title-3">Conditions de location</h2><p>Lisez les conditions, confirmez votre accord, puis signez.</p></div>
            </header>

            <ol class="conditions-list">
              {rentalConditions.map((condition, index) => (
                <li class="condition-row">
                  <span class="condition-number">{String(index + 1).padStart(2, '0')}</span>
                  <p><strong>{condition.title} :</strong> {condition.text}</p>
                </li>
              ))}
            </ol>

            <label class="acceptance-row">
              <input id="conditions-accept" name="conditions_accept" type="checkbox" />
              <span>
                <strong>J’ai lu et j’accepte l’ensemble des conditions de location.</strong>
                <small>Cette confirmation vaut pour les huit conditions présentées ci-dessus.</small>
              </span>
            </label>

            <div class="signature-field">
              <div class="signature-head">
                <div><strong>Signature du locataire *</strong><span>Signez avec la souris, le doigt ou le stylet.</span></div>
                <button id="clear-signature" type="button"><RotateCcw size={16} aria-hidden="true" /> Effacer</button>
              </div>
              <canvas id="signature-canvas" width="1000" height="220" aria-label="Zone de signature"></canvas>
            </div>

            <p class="step-error" data-error-step="3" role="alert"></p>
            <div class="step-actions">
              <button class="action secondary" type="button" data-prev-step><ChevronLeft size={18} aria-hidden="true" /> Retour</button>
              <button class="action primary" type="button" data-next-step>Vérifier le contrat <ChevronRight size={18} aria-hidden="true" /></button>
            </div>
          </section>

          <section class="form-step recap-step" data-step="4" aria-labelledby="step-title-4">
            <header class="print-contract-header">
              <img src="/logo.png" width="72" height="72" alt="Logo de l’ADS" />
              <div>
                <span>Amicale Du Stand · Prêles</span>
                <h1>Contrat de location</h1>
                <p>Stand ADS · 2515 Prêles · Plateau de Diesse</p>
              </div>
              <dl>
                <div><dt>Date de location</dt><dd id="print-header-date">–</dd></div>
                <div><dt>Document préparé le</dt><dd id="print-created-date">–</dd></div>
              </dl>
            </header>

            <header class="step-header">
              <span class="step-number">05</span>
              <div><h2 id="step-title-4">Récapitulatif du contrat</h2><p>Vérifiez les informations avant d’imprimer le document.</p></div>
            </header>

            <div class="recap-grid">
              <section class="recap-block">
                <h3>Location</h3>
                <dl><div><dt>Date</dt><dd id="recap-date">–</dd></div><div><dt>Période</dt><dd id="recap-period">–</dd></div><div><dt>Participants</dt><dd id="recap-people">–</dd></div></dl>
              </section>
              <section class="recap-block">
                <h3>Locataire</h3>
                <dl><div><dt>Responsable</dt><dd id="recap-name">–</dd></div><div><dt>Adresse</dt><dd id="recap-address">–</dd></div><div><dt>Contact</dt><dd id="recap-contact">–</dd></div><div id="recap-iban-row"><dt>IBAN caution</dt><dd id="recap-iban">–</dd></div><div id="recap-remarks-row"><dt>Remarques</dt><dd id="recap-remarks">–</dd></div></dl>
              </section>
              <section class="recap-block full"><h3>Options</h3><ul id="recap-options"></ul></section>
              <section class="payment-box recap-payment">
                <div><span>Après acceptation de la demande</span><strong>La gérance communiquera les informations de paiement</strong></div>
                <div class="payment-total"><span>Total calculé</span><strong id="recap-total">CHF –</strong></div>
              </section>
              <section class="recap-block full print-conditions">
                <h3>Conditions de location acceptées</h3>
                <ol>
                  {rentalConditions.map((condition, index) => (
                    <li><span>{index + 1}.</span><p><strong>{condition.title} :</strong> {condition.text}</p></li>
                  ))}
                </ol>
              </section>
              <section class="recap-block full signature-recap">
                <div>
                  <h3>Signature et acceptation</h3>
                  <p>Le locataire <strong id="recap-signer">–</strong> confirme avoir lu et accepté l’ensemble des conditions de location.</p>
                </div>
                <img id="recap-signature" alt="Signature du locataire" />
              </section>
            </div>
            <div class="send-note"><Mail size={22} stroke-width={1.8} aria-hidden="true" /><p>Imprimez d’abord ce contrat en PDF, puis joignez-le à votre e-mail pour <strong>Mme Daniela Allemann</strong> à <a href="mailto:gerante@ads-preles.ch">gerante@ads-preles.ch</a>.</p></div>
            <div class="step-actions recap-actions">
              <button class="action secondary" type="button" data-prev-step><ChevronLeft size={18} aria-hidden="true" /> Modifier</button>
              <button id="email-contract" class="action secondary" type="button"><Mail size={18} aria-hidden="true" /> Préparer l’e-mail</button>
              <button id="print-contract" class="action primary" type="button"><Printer size={18} aria-hidden="true" /> Imprimer / PDF</button>
            </div>

            <footer class="print-contract-footer">
              <strong>Gérance · Mme Daniela Allemann</strong>
              <span>078 638 47 91 · gerante@ads-preles.ch</span>
              <span>Stand ADS · 2515 Prêles</span>
            </footer>
          </section>
        </form>

        <aside class="booking-sidebar">
          <section class="summary-card">
            <header><p class="booking-eyebrow">Résumé</p><h2>Votre location</h2><span id="summary-date">Aucune date sélectionnée</span></header>
            <dl>
              <div><dt>Période</dt><dd id="summary-period">–</dd></div>
              <div><dt>Personnes</dt><dd id="summary-people">20</dd></div>
              <div><dt>Location de base</dt><dd id="summary-base">–</dd></div>
              <div><dt>Options</dt><dd id="summary-options">CHF 0.–</dd></div>
              <div id="summary-discount-row" class="discount-row hidden"><dt>Réduction membre</dt><dd id="summary-discount">–</dd></div>
            </dl>
            <div class="summary-total"><span>Total indicatif</span><strong id="summary-total">CHF –</strong></div>
            <p>Le montant définitif sera confirmé par la gérance.</p>
          </section>
          <section class="manager-card">
            <p class="booking-eyebrow">Contact</p><h3>Mme Daniela Allemann</h3>
            <a href="tel:+41786384791"><Phone size={17} aria-hidden="true" />078 638 47 91</a>
            <a href="mailto:gerante@ads-preles.ch"><Mail size={17} aria-hidden="true" />gerante@ads-preles.ch</a>
          </section>
        </aside>
      </div>
    </section>
  </main>
  <SiteFooter />
</MainLayout>

<script>
  type Period = 'journee' | 'soiree' | 'complet' | 'consecutif';

  const byId = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const steps = Array.from(document.querySelectorAll<HTMLElement>('.form-step'));
  const progressSteps = Array.from(document.querySelectorAll<HTMLButtonElement>('.progress-step'));
  const periodCards = Array.from(document.querySelectorAll<HTMLButtonElement>('.period-card'));
  const dateField = byId<HTMLInputElement>('date-field');
  const dateAvailabilityFeedback = byId<HTMLElement>('date-availability-feedback');
  const calendarRoot = document.querySelector<HTMLElement>('[data-availability-calendar]');
  const calendarAvailable = calendarRoot?.dataset.calendarAvailable === 'true';
  const bookedDates = new Set<string>(JSON.parse(calendarRoot?.dataset.booked ?? '[]'));
  const holidayField = byId<HTMLInputElement>('holiday-field');
  const daysField = byId<HTMLInputElement>('days-field');
  const daysGroup = byId<HTMLElement>('days-group');
  const peopleField = byId<HTMLInputElement>('people-field');
  const memberField = byId<HTMLInputElement>('member-field');
  const cautionRow = byId<HTMLElement>('caution-row');
  const cautionStatus = byId<HTMLElement>('caution-status');
  const clientIbanField = byId<HTMLInputElement>('client-iban');
  const ibanHelp = byId<HTMLElement>('iban-help');
  const pizzaField = byId<HTMLInputElement>('pizza-field');
  const woodField = byId<HTMLInputElement>('wood-field');
  const cleaningField = byId<HTMLInputElement>('cleaning-field');
  const conditionsAccept = byId<HTMLInputElement>('conditions-accept');
  const canvas = byId<HTMLCanvasElement>('signature-canvas');
  const context = canvas.getContext('2d');

  let currentStep = 0;
  let maxReached = 0;
  let selectedPeriod: Period | null = null;
  let signatureStarted = false;
  let signaturePoints = 0;
  let drawing = false;

  const periodLabels: Record<Period, string> = {
    journee: 'Journée · 10 h à 17 h',
    soiree: 'Soirée · 18 h à 9 h',
    complet: 'Jour complet · environ 23 h',
    consecutif: '3 jours consécutifs ou plus',
  };

  const localToday = () => {
    const now = new Date();
    return [now.getFullYear(), String(now.getMonth() + 1).padStart(2, '0'), String(now.getDate()).padStart(2, '0')].join('-');
  };

  const isWeekendRate = () => {
    if (holidayField.checked) return true;
    if (!dateField.value) return false;
    const date = new Date(`${dateField.value}T12:00:00`);
    return date.getDay() === 0 || date.getDay() === 6;
  };

  const formatDate = (value: string) => {
    if (!value) return '–';
    const [year, month, day] = value.split('-');
    return `${day}.${month}.${year}`;
  };

  const formatAmount = (value: number) => `CHF ${value.toFixed(2)}`;

  const addDays = (value: string, days: number) => {
    const date = new Date(`${value}T12:00:00`);
    date.setDate(date.getDate() + days);
    return [date.getFullYear(), String(date.getMonth() + 1).padStart(2, '0'), String(date.getDate()).padStart(2, '0')].join('-');
  };

  const conflictingDate = () => {
    if (!calendarAvailable || !dateField.value) return null;
    const length = selectedPeriod === 'consecutif' ? Math.max(3, Number(daysField.value) || 3) : 1;
    for (let offset = 0; offset < length; offset += 1) {
      const date = addDays(dateField.value, offset);
      if (bookedDates.has(date)) return date;
    }
    return null;
  };

  const updateDateAvailability = () => {
    const conflict = conflictingDate();
    dateField.setCustomValidity(conflict ? 'Cette date est déjà réservée.' : '');
    dateAvailabilityFeedback.textContent = conflict
      ? `${formatDate(conflict)} est déjà réservé${selectedPeriod === 'consecutif' ? ' dans cette période' : ''}. Choisissez une autre date.`
      : calendarAvailable
        ? 'Cette date apparaît disponible. La gérance doit encore confirmer la demande.'
        : 'La disponibilité sera confirmée par la gérance.';
    dateAvailabilityFeedback.classList.toggle('date-conflict', Boolean(conflict));
  };

  const calculate = () => {
    if (!selectedPeriod) return null;
    const weekend = isWeekendRate();
    const days = Math.max(3, Number(daysField.value) || 3);
    let base = 0;
    if (selectedPeriod === 'consecutif') base = days * 160;
    if (selectedPeriod === 'complet') base = weekend ? 190 : 150;
    if (selectedPeriod === 'journee' || selectedPeriod === 'soiree') base = 90;
    const discount = memberField.checked ? base * 0.2 : 0;
    const options = (!memberField.checked ? 150 : 0) + (pizzaField.checked ? 50 : 0) + (woodField.checked ? 30 : 0);
    return { base, discount, options, total: base - discount + options };
  };

  const updateSummary = () => {
    byId('summary-date').textContent = dateField.value ? formatDate(dateField.value) : 'Aucune date sélectionnée';
    byId('summary-period').textContent = selectedPeriod ? periodLabels[selectedPeriod] : '–';
    byId('summary-people').textContent = `${peopleField.value || 1} pers.`;
    const result = calculate();
    byId('summary-base').textContent = result ? formatAmount(result.base) : '–';
    byId('summary-options').textContent = result ? formatAmount(result.options) : 'CHF 0.00';
    byId('summary-total').textContent = result ? formatAmount(result.total) : 'CHF –';
    const discountRow = byId('summary-discount-row');
    discountRow.classList.toggle('hidden', !result || result.discount === 0);
    byId('summary-discount').textContent = result ? `− ${formatAmount(result.discount)}` : '–';
  };

  const updatePeriodAvailability = () => {
    const weekend = isWeekendRate();
    periodCards.forEach((card) => {
      const period = card.dataset.period as Period;
      const disabled = weekend && (period === 'journee' || period === 'soiree');
      card.disabled = disabled;
      card.classList.toggle('disabled', disabled);
      if (disabled && selectedPeriod === period) {
        selectedPeriod = null;
        card.classList.remove('selected');
      }
    });
    const completePrice = document.querySelector<HTMLElement>('[data-price="complet"]');
    const consecutivePrice = document.querySelector<HTMLElement>('[data-price="consecutif"]');
    if (completePrice) completePrice.textContent = weekend ? 'CHF 190.–' : 'CHF 150.–';
    if (consecutivePrice) consecutivePrice.textContent = 'CHF 160.– / jour';
    updateDateAvailability();
    updateSummary();
  };

  const showStep = (index: number) => {
    currentStep = Math.max(0, Math.min(index, steps.length - 1));
    maxReached = Math.max(maxReached, currentStep);
    steps.forEach((step, i) => step.classList.toggle('active', i === currentStep));
    progressSteps.forEach((step, i) => {
      step.classList.toggle('active', i === currentStep);
      step.classList.toggle('done', i < currentStep);
      step.disabled = i > maxReached;
      if (i === currentStep) step.setAttribute('aria-current', 'step');
      else step.removeAttribute('aria-current');
    });
    if (currentStep === 4) renderRecap();
    document.querySelector('.progress')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  };

  const setStepError = (step: number, message: string) => {
    const target = document.querySelector<HTMLElement>(`[data-error-step="${step}"]`);
    if (target) target.textContent = message;
  };

  const validateStep = (step: number) => {
    setStepError(step, '');
    if (step === 0) {
      if (!dateField.value) { setStepError(step, 'Sélectionnez une date de location.'); dateField.focus(); return false; }
      const conflict = conflictingDate();
      if (conflict) { setStepError(step, `La date du ${formatDate(conflict)} est déjà réservée.`); dateField.focus(); return false; }
      if (!selectedPeriod) { setStepError(step, 'Sélectionnez une période disponible.'); return false; }
      if (selectedPeriod === 'consecutif' && Number(daysField.value) < 3) { setStepError(step, 'La formule consécutive nécessite au moins trois jours.'); daysField.focus(); return false; }
      if (Number(peopleField.value) < 1 || Number(peopleField.value) > 70) { setStepError(step, 'Le nombre de personnes doit être compris entre 1 et 70.'); peopleField.focus(); return false; }
    }
    if (step === 2) {
      const required = ['first-name', 'last-name', 'address-field', 'postal-field', 'city-field', 'phone-field'].map((id) => byId<HTMLInputElement>(id));
      const missing = required.find((field) => !field.value.trim());
      if (missing) { setStepError(step, 'Complétez tous les champs obligatoires.'); missing.focus(); return false; }
      const email = byId<HTMLInputElement>('email-field');
      if (email.value && !email.checkValidity()) { setStepError(step, 'Saisissez une adresse e-mail valide.'); email.focus(); return false; }
      if (!memberField.checked && !clientIbanField.value.trim()) { setStepError(step, 'L’IBAN est requis pour rembourser la caution des non-membres.'); clientIbanField.focus(); return false; }
    }
    if (step === 3) {
      if (!conditionsAccept.checked) { setStepError(step, 'Confirmez avoir lu et accepté l’ensemble des conditions.'); conditionsAccept.focus(); return false; }
      if (!signatureStarted || signaturePoints < 5) { setStepError(step, 'La signature du locataire est requise.'); return false; }
    }
    return true;
  };

  const optionTexts = () => {
    const options: string[] = [];
    if (memberField.checked) options.push('Membre ADS : réduction de 20 %');
    if (!memberField.checked) options.push('Caution non-membre obligatoire : CHF 150.–');
    if (pizzaField.checked) options.push('Four à pizza : CHF 50.–');
    if (woodField.checked) options.push('Bois supplémentaire : CHF 30.–');
    options.push(cleaningField.checked ? 'Nettoyage effectué par le locataire' : 'Nettoyage à facturer : CHF 50.–/h');
    return options;
  };

  const renderRecap = () => {
    const firstName = byId<HTMLInputElement>('first-name').value.trim();
    const lastName = byId<HTMLInputElement>('last-name').value.trim();
    const address = byId<HTMLInputElement>('address-field').value.trim();
    const postal = byId<HTMLInputElement>('postal-field').value.trim();
    const city = byId<HTMLInputElement>('city-field').value.trim();
    const phone = byId<HTMLInputElement>('phone-field').value.trim();
    const email = byId<HTMLInputElement>('email-field').value.trim();
    const iban = clientIbanField.value.trim();
    const remarks = byId<HTMLTextAreaElement>('remarks-field').value.trim();
    const days = Math.max(3, Number(daysField.value) || 3);
    byId('recap-date').textContent = formatDate(dateField.value);
    byId('recap-period').textContent = selectedPeriod ? `${periodLabels[selectedPeriod]}${selectedPeriod === 'consecutif' ? ` · ${days} jours` : ''}` : '–';
    byId('recap-people').textContent = `${peopleField.value} personnes`;
    byId('recap-name').textContent = `${firstName} ${lastName}`.trim();
    byId('recap-signer').textContent = `${firstName} ${lastName}`.trim();
    byId('print-header-date').textContent = formatDate(dateField.value);
    byId('print-created-date').textContent = new Intl.DateTimeFormat('fr-CH').format(new Date());
    byId('recap-address').textContent = `${address}, ${postal} ${city}`;
    byId('recap-contact').textContent = [phone, email].filter(Boolean).join(' · ');
    byId('recap-iban').textContent = iban || 'Non renseigné';
    byId('recap-iban-row').classList.toggle('hidden', memberField.checked && !iban);
    byId('recap-remarks').textContent = remarks || 'Aucune';
    byId('recap-remarks-row').classList.toggle('hidden', !remarks);
    const optionList = byId<HTMLUListElement>('recap-options');
    optionList.replaceChildren();
    optionTexts().forEach((text) => { const item = document.createElement('li'); item.textContent = text; optionList.append(item); });
    const result = calculate();
    byId('recap-total').textContent = result ? formatAmount(result.total) : 'CHF –';
    byId<HTMLImageElement>('recap-signature').src = canvas.toDataURL('image/png');
  };

  const signaturePosition = (event: PointerEvent) => {
    const rect = canvas.getBoundingClientRect();
    return { x: (event.clientX - rect.left) * (canvas.width / rect.width), y: (event.clientY - rect.top) * (canvas.height / rect.height) };
  };

  canvas.addEventListener('pointerdown', (event) => {
    if (!context) return;
    drawing = true; signatureStarted = true; signaturePoints = 1; canvas.setPointerCapture(event.pointerId);
    const point = signaturePosition(event); context.beginPath(); context.moveTo(point.x, point.y);
  });
  canvas.addEventListener('pointermove', (event) => {
    if (!context || !drawing) return;
    const point = signaturePosition(event); signaturePoints += 1; context.lineTo(point.x, point.y);
    context.strokeStyle = '#123c36'; context.lineWidth = 4; context.lineCap = 'round'; context.lineJoin = 'round'; context.stroke();
  });
  const stopDrawing = () => { drawing = false; };
  canvas.addEventListener('pointerup', stopDrawing);
  canvas.addEventListener('pointercancel', stopDrawing);
  byId('clear-signature').addEventListener('click', () => { context?.clearRect(0, 0, canvas.width, canvas.height); signatureStarted = false; signaturePoints = 0; });

  periodCards.forEach((card) => {
    card.addEventListener('click', () => {
      if (card.disabled) return;
      selectedPeriod = card.dataset.period as Period;
      periodCards.forEach((item) => { const selected = item === card; item.classList.toggle('selected', selected); item.setAttribute('aria-pressed', String(selected)); });
      daysGroup.classList.toggle('hidden', selectedPeriod !== 'consecutif');
      updateDateAvailability();
      updateSummary();
    });
  });

  document.querySelectorAll<HTMLButtonElement>('[data-counter]').forEach((button) => {
    button.addEventListener('click', () => {
      const next = Number(peopleField.value || 1) + Number(button.dataset.counter || 0);
      peopleField.value = String(Math.max(1, Math.min(70, next)));
      updateSummary();
    });
  });

  const updateCautionState = () => {
    const applies = !memberField.checked;
    cautionRow.classList.toggle('applied', applies);
    cautionRow.classList.toggle('waived', !applies);
    cautionStatus.textContent = applies ? '+ CHF 150.–' : 'Non applicable';
    clientIbanField.required = applies;
    ibanHelp.textContent = applies
      ? 'Obligatoire pour les non-membres afin de permettre le remboursement de la caution.'
      : 'Facultatif pour les membres ADS, qui ne versent pas de caution.';
  };

  document.querySelectorAll<HTMLInputElement>('.option-row input').forEach((input) => {
    input.addEventListener('change', () => {
      if (input === memberField) updateCautionState();
      updateSummary();
    });
  });

  dateField.addEventListener('change', updatePeriodAvailability);
  holidayField.addEventListener('change', updatePeriodAvailability);
  daysField.addEventListener('input', () => { updateDateAvailability(); updateSummary(); });
  peopleField.addEventListener('input', updateSummary);
  document.querySelectorAll<HTMLButtonElement>('[data-next-step]').forEach((button) => button.addEventListener('click', () => { if (validateStep(currentStep)) showStep(currentStep + 1); }));
  document.querySelectorAll<HTMLButtonElement>('[data-prev-step]').forEach((button) => button.addEventListener('click', () => showStep(currentStep - 1)));
  progressSteps.forEach((button) => button.addEventListener('click', () => { const target = Number(button.dataset.goStep); if (target <= maxReached) showStep(target); }));
  byId('print-contract').addEventListener('click', () => window.print());
  byId('email-contract').addEventListener('click', () => {
    const name = `${byId<HTMLInputElement>('first-name').value} ${byId<HTMLInputElement>('last-name').value}`.trim();
    const period = selectedPeriod ? periodLabels[selectedPeriod] : '';
    const result = calculate();
    const subject = `Contrat de location du Stand ADS — ${formatDate(dateField.value)} — ${name}`;
    const body = ['Bonjour Mme Allemann,', '', 'Veuillez trouver mon contrat de location en pièce jointe.', '', `Date : ${formatDate(dateField.value)}`, `Période : ${period}`, `Nombre de personnes : ${peopleField.value}`, `Total indicatif : ${result ? formatAmount(result.total) : 'à confirmer'}`, '', 'Meilleures salutations,', name].join('\n');
    window.location.href = `mailto:gerante@ads-preles.ch?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  });

  dateField.min = localToday();
  const requestedDate = new URLSearchParams(window.location.search).get('date');
  if (requestedDate && /^\d{4}-\d{2}-\d{2}$/.test(requestedDate) && requestedDate >= localToday() && !bookedDates.has(requestedDate)) {
    dateField.value = requestedDate;
  }
  updateCautionState();
  showStep(0);
  updatePeriodAvailability();
</script>

