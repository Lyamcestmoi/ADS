  .mobile-progress { display: none; }

  .booking-content { padding: 28px 0 64px; }
  .booking-layout { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 28px; align-items: start; }
  .form-card { min-width: 0; padding: 30px; border: 1px solid var(--line); border-radius: 0; background: var(--white); box-shadow: none; }
  .included-note, .send-note { display: flex; gap: 12px; align-items: flex-start; padding: 15px 17px; border-radius: var(--radius-sm); }
  .included-note svg, .send-note svg { flex: 0 0 auto; margin-top: 2px; }

  .form-step { display: none; }
  .form-step.active { display: block; }
  .form-step.active + .form-step.active { margin-top: 0; }
  .step-header { margin-bottom: 24px; }
  .step-header h2 { margin: 0; color: var(--forest-900); font-size: clamp(23px, 2.6vw, 28px); font-weight: 700; letter-spacing: -.025em; line-height: 1.3; }
  .step-header p { margin: 7px 0 0; color: var(--muted); font-size: 16px; }
  .subsection-header { margin-top: 28px; padding-top: 28px; border-top: 1px solid var(--line); }
  .subsection-header h2 { font-size: 23px; }

  .field-grid { display: grid; gap: 16px; }
  .two-cols { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .full { grid-column: 1 / -1; }
  .postal-field { max-width: 220px; }
  .field { display: grid; gap: 8px; }
  .field > span, .field > label, .plain-fieldset legend { color: var(--ink); font-size: 16px; font-weight: 600; }
  .field small { color: var(--muted); font-size: 14px; }
  .booking-date-controls { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 16px; align-items: end; }
  .date-field-feedback.date-conflict { color: #a62f28; font-weight: 700; }
  .date-field-feedback:empty { display: none; }
  .booking-date-controls .action { min-height: 54px; }
  input, textarea { width: 100%; min-height: 54px; padding: 13px 15px; border: 1px solid var(--line); border-radius: 0; background: var(--white); color: var(--ink); font-size: 16px; }
  textarea { resize: vertical; }
  input:focus, textarea:focus { border-color: var(--blue); box-shadow: 0 0 0 3px rgba(17,135,178,.12); }
  [aria-invalid='true'] { border-color: #a62f28 !important; box-shadow: 0 0 0 3px rgba(166,47,40,.14) !important; }
  input[type='checkbox'] { width: 19px; min-height: 19px; padding: 0; accent-color: var(--blue); }
  .check-card { display: flex; gap: 12px; align-items: center; min-height: 52px; margin-top: 31px; padding: 10px 14px; border: 1px solid var(--line); border-radius: 0; background: var(--white); cursor: pointer; }
  .check-card span, .check-card strong, .check-card small { display: block; }
  .check-card strong { font-size: 15px; }
  .check-card small { color: var(--muted); font-size: 13px; }

  .plain-fieldset { margin: 26px 0 0; padding: 0; border: 0; }
  .plain-fieldset legend { margin-bottom: 14px; }
  .period-grid { display: grid; border: 1px solid var(--line); }
  .period-card { display: grid; grid-template-columns: 20px minmax(0, 1fr) auto; gap: 14px; align-items: center; min-height: 72px; padding: 14px 16px; background: var(--white); color: var(--ink); text-align: left; cursor: pointer; }
  .period-card + .period-card { border-top: 1px solid var(--line); }
  .period-card input { width: 20px; height: 20px; min-height: 20px; margin: 0; padding: 0; accent-color: var(--forest-900); }
  .period-copy { min-width: 0; }
  .period-copy strong, .period-copy small { display: block; }
  .period-copy strong { font-size: 16px; font-weight: 600; }
  .period-copy small { color: var(--muted); font-size: 14px; line-height: 1.5; }
  .period-card b { color: var(--forest-900); font-size: 16px; font-weight: 600; white-space: nowrap; }
  .period-card:hover { background: #f4f7f4; }
  .period-card:has(input:checked) { background: #eaf2ec; box-shadow: inset 3px 0 0 var(--forest-900); }
  .period-card:has(input:focus-visible) { outline: 3px solid var(--blue); outline-offset: 3px; z-index: 1; }
  .period-card:has(input:disabled) { display: none; }
  .field-hint { margin: 12px 0 0; color: var(--muted); font-size: 14px; line-height: 1.55; }
  #days-group { max-width: 220px; margin-top: 22px; }
  .hidden { display: none !important; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  .participants-row { display: flex; flex-wrap: wrap; gap: 12px 24px; align-items: end; margin-top: 24px; }
  .participants-row .field { flex: 0 1 220px; }
  .counter { display: grid; grid-template-columns: 48px 1fr 48px; border: 1px solid var(--line); border-radius: 0; overflow: hidden; background: var(--white); }
  .counter input { min-width: 0; border: 0; border-radius: 0; text-align: center; font-weight: 600; }
  .counter button { border: 0; background: #f1f4f1; color: var(--forest-900); font-size: 21px; font-weight: 600; cursor: pointer; }
  .capacity-note { margin: 0; padding-bottom: 16px; color: var(--muted); font-size: 14px; }

  .option-list { display: grid; gap: 8px; }
  .option-row { display: grid; grid-template-columns: 44px 1fr auto 28px; gap: 12px; align-items: center; min-height: 78px; padding: 12px 14px; border: 1px solid var(--line); border-radius: var(--radius-sm); background: var(--white); cursor: pointer; transition: border-color 150ms ease, background 150ms ease; }
  .option-row > input { position: absolute; opacity: 0; pointer-events: none; }
  .option-row:has(input:checked) { border-color: var(--blue); background: var(--blue-soft); }
  .option-row.disabled { opacity: .42; cursor: not-allowed; }
  .automatic-option { cursor: default; }
  .automatic-option.applied { border-color: var(--blue); background: var(--blue-soft); }
  .automatic-option.waived { background: var(--cream); opacity: .72; }
  .option-icon { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; background: var(--cream); color: var(--forest-900); }
  .option-copy, .option-copy strong, .option-copy small { display: block; }
  .option-copy strong { font-size: 17px; }
  .option-copy small { margin-top: 2px; color: var(--muted); font-size: 15px; line-height: 1.4; }
  .option-row > b { color: var(--forest-900); font-size: 16px; white-space: nowrap; }
  .option-check { display: grid; place-items: center; width: 25px; height: 25px; border: 1px solid var(--line); border-radius: 50%; color: transparent; }
  .option-row:has(input:checked) .option-check { border-color: var(--blue); background: var(--blue); color: var(--white); }
  .automatic-option.applied .option-check { border-color: var(--blue); background: var(--blue); color: var(--white); }
  .included-note { margin-top: 22px; background: #fbf1bd; color: #594b08; font-size: 15px; line-height: 1.5; }

  .conditions-disclosure { border: 1px solid var(--line); background: var(--white); }
  .conditions-disclosure > summary { display: flex; justify-content: space-between; gap: 16px; align-items: center; padding: 17px 18px; color: var(--forest-900); font-size: 15px; font-weight: 800; cursor: pointer; list-style: none; }
  .conditions-disclosure > summary::-webkit-details-marker { display: none; }
  .conditions-disclosure > summary svg { flex: 0 0 auto; transition: transform 180ms ease; }
  .conditions-disclosure[open] > summary { border-bottom: 1px solid var(--line); }
  .conditions-disclosure[open] > summary svg { transform: rotate(90deg); }
  .conditions-list { display: grid; gap: 8px; margin: 0; padding: 12px; list-style: none; }
  .condition-row { display: grid; grid-template-columns: 36px 1fr; gap: 12px; align-items: start; padding: 13px 14px; border: 1px solid var(--line); border-radius: 0; background: var(--white); }
  .condition-number { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; background: var(--forest-100); color: var(--forest-900); font-size: 11px; font-weight: 900; }
  .condition-row p { margin: 3px 0 0; color: var(--muted); font-size: 15px; line-height: 1.5; }
  .condition-row strong { color: var(--ink); }
  .acceptance-row { display: grid; grid-template-columns: 24px 1fr; gap: 14px; align-items: start; margin-top: 20px; padding: 18px; border: 2px solid var(--line); border-radius: var(--radius-sm); background: var(--white); cursor: pointer; transition: border-color 150ms ease, background 150ms ease; }
  .acceptance-row:has(input:checked) { border-color: var(--blue); background: var(--blue-soft); }
  .acceptance-row input { margin-top: 3px; }
  .acceptance-row span, .acceptance-row strong, .acceptance-row small { display: block; }
  .acceptance-row strong { color: var(--forest-900); font-size: 16px; }
  .acceptance-row small { margin-top: 3px; color: var(--muted); font-size: 14px; line-height: 1.45; }
  .signature-field { margin-top: 30px; border: 1px solid var(--line); border-radius: var(--radius-sm); overflow: hidden; background: var(--white); }
  .signature-head { display: flex; justify-content: space-between; gap: 20px; align-items: center; padding: 15px 18px; border-bottom: 1px solid var(--line); }
  .signature-head strong, .signature-head span { display: block; }
  .signature-head strong { font-size: 15px; }
  .signature-head span { color: var(--muted); font-size: 13px; }
  .signature-head button { display: inline-flex; gap: 7px; align-items: center; padding: 8px 11px; border: 1px solid var(--line); border-radius: 0; background: var(--paper); color: var(--forest-900); font-size: 13px; font-weight: 700; cursor: pointer; }
  #signature-canvas { display: block; width: 100%; height: 180px; touch-action: none; cursor: crosshair; }
  .signature-alternative { margin-top: 16px; padding: 18px; border: 1px solid var(--line); background: var(--white); }

  .step-error { margin: 18px 0 0; color: #a62f28; font-size: 15px; font-weight: 600; }
  .step-error:empty { display: none; }
  .step-actions { display: flex; justify-content: space-between; gap: 12px; margin-top: 24px; padding-top: 20px; border-top: 1px solid var(--line); }
  .step-actions.end { justify-content: flex-end; }
  .action { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 52px; padding: 12px 21px; border: 1px solid transparent; border-radius: 0; font-size: 15px; font-weight: 800; cursor: pointer; }
  .action.primary { background: var(--forest-900); color: var(--white); }
  .action.primary:hover { background: var(--forest-800); }
  .action.secondary { border-color: var(--line); background: var(--white); color: var(--forest-900); }
  .action.secondary:hover { border-color: var(--forest-900); }

  .booking-sidebar { position: sticky; top: 164px; min-width: 0; display: grid; gap: 16px; }
  .summary-card, .manager-card { padding: 24px; border-radius: var(--radius); }
  .summary-card { border: 1px solid var(--line); border-top: 3px solid var(--forest-900); background: var(--white); color: var(--ink); }
  .summary-card .booking-eyebrow { color: var(--muted); font-size: 12px; letter-spacing: .08em; }
  .summary-card h2 { margin: 0; font-size: 22px; font-weight: 700; letter-spacing: -.025em; }
  .summary-card header > span { display: block; margin-top: 8px; color: var(--muted); font-size: 14px; }
  .summary-card dl { margin: 18px 0 0; }
  .summary-card dl div { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, auto); gap: 14px; padding: 10px 0; border-bottom: 1px solid var(--line); }
  .summary-card dt, .summary-card dd { margin: 0; font-size: 15px; }
  .summary-card dt { color: var(--muted); }
  .summary-card dd { overflow-wrap: anywhere; font-weight: 600; text-align: right; }
  .summary-card .discount-row dd { color: var(--forest-800); }
  .summary-total { display: flex; justify-content: space-between; gap: 15px; align-items: end; padding: 17px 0 7px; }
  .summary-total span { color: var(--ink); font-size: 14px; }
  .summary-total strong { color: var(--forest-900); font-size: 24px; }
  .summary-card > p { margin: 10px 0 0; color: var(--muted); font-size: 14px; line-height: 1.5; }
  .manager-card { border: 1px solid var(--line); background: transparent; }
  .manager-card summary { cursor: pointer; color: var(--forest-900); font-size: 16px; font-weight: 600; }
  .manager-card[open] summary { margin-bottom: 18px; }
  .manager-card .booking-eyebrow { color: var(--blue); }
  .manager-card h3 { margin: 0 0 17px; font-size: 20px; }
  .manager-card a { display: flex; gap: 9px; align-items: center; overflow-wrap: anywhere; padding: 8px 0; color: var(--forest-900); font-size: 15px; font-weight: 600; text-decoration: none; }
  .manager-card a:hover { color: var(--blue); }

  .recap-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 15px; }
  .print-contract-header, .print-contract-footer { display: none; }
  .recap-block { padding: 20px; border: 1px solid var(--line); border-radius: var(--radius-sm); background: var(--white); }
  .recap-block.full { grid-column: 1 / -1; }
  .recap-block h3 { margin: 0 0 15px; color: var(--forest-900); font-size: 18px; }
  .recap-block dl { margin: 0; }
  .recap-block dl div { display: grid; grid-template-columns: 110px 1fr; gap: 15px; padding: 8px 0; border-bottom: 1px solid var(--line); }
  .recap-block dl div:last-child { border-bottom: 0; }
  .recap-block dt, .recap-block dd { margin: 0; font-size: 14px; }
  .recap-block dt { color: var(--muted); }
  .recap-block dd { overflow-wrap: anywhere; font-weight: 700; }
  .recap-block ul { display: grid; gap: 7px; margin: 0; padding-left: 20px; color: var(--muted); font-size: 14px; }
  .print-conditions { background: #f7f4eb; }
  .print-conditions ol { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px 24px; margin: 0; padding: 0; list-style: none; }
  .print-conditions li { display: grid; grid-template-columns: 22px 1fr; gap: 7px; align-items: start; }
  .print-conditions li span { color: var(--blue); font-size: 13px; font-weight: 900; }
  .print-conditions li p { margin: 0; color: var(--muted); font-size: 13px; line-height: 1.45; }
  .print-conditions li strong { color: var(--ink); }
  .signature-recap { display: grid; grid-template-columns: 1fr minmax(220px, .7fr); gap: 24px; align-items: center; }
  .signature-recap p { margin: 0; color: var(--muted); font-size: 14px; }
  #recap-signature { width: 100%; min-height: 90px; max-height: 120px; object-fit: contain; object-position: center; border-left: 1px solid var(--line); }
  .typed-signature { margin: 0; padding: 24px; border-left: 1px solid var(--line); color: var(--forest-900) !important; font-size: 22px !important; font-style: italic; font-weight: 700; text-align: center; }
  .payment-box { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 24px; align-items: start; padding: 22px; border-radius: var(--radius-sm); background: var(--forest-900); color: var(--white); }
  .recap-payment { grid-column: 1 / -1; }
  .payment-box span, .payment-box strong { display: block; }
  .payment-box span { color: rgba(255,255,255,.62); font-size: 13px; }
  .payment-box strong { margin-top: 4px; font-size: 18px; letter-spacing: .02em; }
  .payment-copy h3 { margin: 0 0 14px; font-size: 21px; }
  .payment-copy p { margin: 13px 0 5px; color: rgba(255,255,255,.85); font-size: 13px; line-height: 1.4; }
  .payment-copy p b, .payment-copy p span { display: inline; color: inherit; font-size: inherit; }
  .payment-copy small { display: block; color: rgba(255,255,255,.8); font-size: 12px; line-height: 1.4; }
  .payment-copy a { display: inline-block; margin-top: 8px; color: var(--yellow); font-weight: 800; }
  .payment-methods { display: grid; gap: 10px; margin: 0; padding: 0; border: 0; }
  .payment-methods label { display: flex; align-items: center; gap: 10px; min-height: 36px; cursor: pointer; font-size: 14px; }
  .payment-methods input { width: 20px; height: 20px; min-height: 20px; padding: 0; accent-color: var(--yellow); }
  .bank-iban { overflow-wrap: anywhere; }
  .reservation-hold { padding: 20px; border: 1px solid var(--forest-900); background: #edf5f0; }
  .reservation-hold h3 { margin: 0 0 10px; color: var(--forest-900); font-size: 19px; }
  .reservation-hold p { margin: 8px 0; font-size: 14px; line-height: 1.5; }
  .reservation-hold dl { margin: 14px 0; }
  .reservation-hold dl div { margin-block: 8px; }
  .reservation-hold dt { font-size: 12px; color: var(--muted); }
  .reservation-hold dd { margin: 3px 0 0; font-weight: 700; overflow-wrap: anywhere; }
  .holiday-notice { margin: 12px 0 0; padding: 10px 14px; border-left: 3px solid #9b7519; background: #fbf4df; color: #665019; font-size: 14px; line-height: 1.5; }
  .holiday-notice[hidden], #period-help[hidden] { display: none; }
  .membership-verification summary { padding-block: 10px; cursor: pointer; font-weight: 700; }
  .membership-verification { margin-block: 22px; padding: 14px 18px; border: 1px solid var(--line); }
  .membership-verification p { font-size: 14px; line-height: 1.5; }
  .membership-verification .action { margin-top: 12px; }
  .payment-total { text-align: right; }
  .payment-total strong { color: var(--yellow); font-size: 24px; }
  .send-note { margin-top: 16px; border: 1px solid #d9c04f; background: #fbf1bd; color: #594b08; }
  .send-note p { margin: 0; font-size: 14px; line-height: 1.55; }
  .send-note a { color: inherit; font-weight: 800; }
  .recap-actions { flex-wrap: wrap; justify-content: flex-end; }
  .recap-actions [data-prev-step] { order: -1; margin-right: auto; }

  @media (max-width: 1020px) {
    .booking-layout { grid-template-columns: minmax(0, 1fr); }
    .booking-sidebar { position: static; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: start; }
  }
  @media (max-width: 760px) {
    .reservation-shell { width: calc(100% - 32px); }
    .booking-hero { padding: 18px 0 20px; }
    .back-link { margin-bottom: 10px; }
    .availability-calendar-panel :global(.calendar-day) { min-height: 46px; }
    .progress { top: 72px; }
    .progress-grid { display: none; }
    .mobile-progress { display: grid; grid-template-columns: minmax(0, 1fr) minmax(70px, .55fr) auto; gap: 16px; align-items: center; min-height: 64px; padding-block: 10px; }
    .mobile-progress span, .mobile-progress strong { display: block; }
    .mobile-progress [data-mobile-step] { display: inline; }
    .mobile-progress span { color: var(--muted); font-size: 13px; font-weight: 600; }
    .mobile-progress strong { margin-top: 3px; color: var(--forest-900); font-size: 16px; }
    .mobile-progress-track { height: 5px; overflow: hidden; background: var(--line); }
    .mobile-progress-track i { display: block; width: 33.333%; height: 100%; background: var(--forest-900); }
    .mobile-price { padding-left: 14px; border-left: 1px solid var(--line); text-align: right; }
    .mobile-price span { color: var(--muted); font-size: 12px; }
    .mobile-price strong { margin-top: 2px; font-size: 16px; white-space: nowrap; }
    .booking-content { padding: 16px 0 64px; }
    .two-cols, .period-grid, .participants-row, .recap-grid, .booking-sidebar { grid-template-columns: 1fr; }
    .full { grid-column: auto; }
