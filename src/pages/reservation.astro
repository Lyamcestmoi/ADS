---
import {
  ArrowLeft, CalendarDays, Check, ChevronLeft, ChevronRight,
  CircleDollarSign, Flame, Info, KeyRound, Mail, Phone, Pizza,
  Printer, RotateCcw, ShieldCheck, Sparkles, UserRound, Users,
} from '@lucide/astro';
import MainLayout from '../layouts/MainLayout.astro';
import AvailabilityCalendar from '../components/AvailabilityCalendar.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { getAvailability, googleCalendarUrl } from '../lib/availability';
import { localeCodes, pagePaths, reservationTranslations, type Locale } from '../lib/i18n';

interface Props { locale?: Locale; }
const { locale = 'fr' } = Astro.props;
const t = reservationTranslations[locale];
const title = t.title;
const description = t.description;

const availability = await getAvailability();
const syncedLabel = availability.syncedAt
  ? new Intl.DateTimeFormat(localeCodes[locale], {
      dateStyle: 'short',
      timeStyle: 'short',
      timeZone: 'Europe/Zurich',
    }).format(new Date(availability.syncedAt))
  : null;

const rentalConditions = t.conditions.map(([conditionTitle, text]) => ({ title: conditionTitle, text }));
---

<MainLayout title={title} description={description} locale={locale} alternatePaths={pagePaths.reservation}>
  <SiteHeader active="reservation" locale={locale} />

  <main id="main-content" class="booking-page" tabindex="-1" data-runtime-i18n={JSON.stringify(t.runtime)} data-locale-code={localeCodes[locale]}>
    <section class="booking-hero">
      <div class="reservation-shell booking-hero-grid">
        <div>
          <a class="back-link" href={pagePaths.home[locale]}>
            <ArrowLeft size={17} stroke-width={1.8} aria-hidden="true" />
            {t.back}
          </a>
          <p class="booking-eyebrow">{t.contract}</p>
          <h1>{t.heroTitle}</h1>
        </div>
        <p class="booking-lead">
          {t.heroLead}
        </p>
      </div>
    </section>

    <nav class="progress" aria-label={t.progressLabel}>
      <div class="reservation-shell progress-grid">
        {t.progress.map((label, index) => <button class:list={['progress-step', { active: index === 0 }]} type="button" data-go-step={index} aria-current={index === 0 ? 'step' : undefined}><span>{String(index + 1).padStart(2, '0')}</span><strong>{label}</strong></button>)}
      </div>
    </nav>

    <section class="booking-content">
      <div class="reservation-shell booking-layout">
        <form id="booking-form" class="form-card" novalidate>
          <div class="privacy-note" role="note">
            <ShieldCheck size={22} stroke-width={1.8} aria-hidden="true" />
            <div>
              <strong>{t.privacyTitle}</strong>
              <span>{t.privacyCopy}</span>
            </div>
          </div>

          <section class="form-step active" data-step="0" aria-labelledby="step-title-0">
            <header class="step-header">
              <span class="step-number">01</span>
              <div><h2 id="step-title-0">{t.step0Title}</h2><p>{t.step0Copy}</p></div>
            </header>

            <div class="field-grid two-cols">
              <label class="field">
                <span>{t.startDate}</span>
                <input id="date-field" name="date" type="date" required aria-describedby="date-availability-feedback" />
                <small id="date-availability-feedback">{t.dateHelp}</small>
              </label>
              <label class="check-card holiday-card">
                <input id="holiday-field" name="jour_ferie" type="checkbox" />
                <span><strong>{t.holiday}</strong><small>{t.holidayHelp}</small></span>
              </label>
            </div>

            <fieldset class="plain-fieldset">
              <legend>{t.period}</legend>
              <div class="period-grid">
                <button class="period-card" type="button" data-period="journee" aria-pressed="false">
                  <CalendarDays size={22} stroke-width={1.7} aria-hidden="true" />
                  <strong>{t.day}</strong><span>{t.dayTime}</span><b data-price="journee">CHF 90.–</b>
                </button>
                <button class="period-card" type="button" data-period="soiree" aria-pressed="false">
                  <Sparkles size={22} stroke-width={1.7} aria-hidden="true" />
                  <strong>{t.evening}</strong><span>{t.eveningTime}</span><b data-price="soiree">CHF 90.–</b>
                </button>
                <button class="period-card" type="button" data-period="complet" aria-pressed="false">
                  <CircleDollarSign size={22} stroke-width={1.7} aria-hidden="true" />
                  <strong>{t.fullDay}</strong><span>{t.fullDayTime}</span><b data-price="complet">CHF 150.–</b>
                </button>
                <button class="period-card" type="button" data-period="consecutif" aria-pressed="false">
                  <CalendarDays size={22} stroke-width={1.7} aria-hidden="true" />
                  <strong>{t.consecutive}</strong><span>{t.perDay}</span><b data-price="consecutif">{t.consecutivePrice}</b>
                </button>
              </div>
              <p id="period-help" class="field-hint">{t.periodHelp}</p>
            </fieldset>

            <div id="days-group" class="field hidden">
              <label for="days-field">{t.days}</label>
              <input id="days-field" name="nombre_jours" type="number" min="3" max="30" value="3" />
            </div>

            <div class="participants-row">
              <div class="field">
                <label for="people-field">{t.people}</label>
                <div class="counter">
                  <button type="button" data-counter="-1" aria-label={t.removePerson}>−</button>
                  <input id="people-field" name="participants" type="number" min="1" max="70" value="20" required />
                  <button type="button" data-counter="1" aria-label={t.addPerson}>+</button>
                </div>
              </div>
              <div class="capacity-note"><Users size={22} stroke-width={1.7} aria-hidden="true" /><span><strong>{t.capacity}</strong> · {t.capacityCopy}</span></div>
            </div>

            <p id="error-step-0" class="step-error" data-error-step="0" role="alert"></p>
            <div class="step-actions end"><button class="action primary" type="button" data-next-step>{t.continue} <ChevronRight size={18} aria-hidden="true" /></button></div>
          </section>

          <section class="form-step" data-step="1" aria-labelledby="step-title-1">
            <header class="step-header">
              <span class="step-number">02</span>
              <div><h2 id="step-title-1">{t.step1Title}</h2><p>{t.step1Copy}</p></div>
            </header>

            <div class="option-list">
              <label class="option-row member-option">
                <input id="member-field" name="membre_ads" type="checkbox" />
                <span class="option-icon"><UserRound size={22} stroke-width={1.8} /></span>
                <span class="option-copy"><strong>{t.member}</strong><small>{t.memberHelp}</small></span>
                <b>−20 %</b><span class="option-check"><Check size={17} /></span>
              </label>
              <div id="caution-row" class="option-row automatic-option applied" role="status" aria-live="polite">
                <span class="option-icon"><KeyRound size={22} stroke-width={1.8} /></span>
                <span class="option-copy"><strong>{t.deposit}</strong><small>{t.depositHelp}</small></span>
                <b id="caution-status">+ CHF 150.–</b><span class="option-check"><Check size={17} /></span>
              </div>
              <label class="option-row">
                <input id="pizza-field" name="four_pizza" type="checkbox" />
                <span class="option-icon"><Pizza size={22} stroke-width={1.8} /></span>
                <span class="option-copy"><strong>{t.pizza}</strong><small>{t.pizzaHelp}</small></span>
                <b>+ CHF 50.–</b><span class="option-check"><Check size={17} /></span>
              </label>
              <label class="option-row">
                <input id="wood-field" name="bois" type="checkbox" />
                <span class="option-icon"><Flame size={22} stroke-width={1.8} /></span>
                <span class="option-copy"><strong>{t.wood}</strong><small>{t.woodHelp}</small></span>
                <b>+ CHF 30.–</b><span class="option-check"><Check size={17} /></span>
              </label>
              <label class="option-row">
                <input id="cleaning-field" name="nettoyage_locataire" type="checkbox" checked />
                <span class="option-icon"><Sparkles size={22} stroke-width={1.8} /></span>
                <span class="option-copy"><strong>{t.cleaning}</strong><small>{t.cleaningHelp}</small></span>
                <b>{t.includedPrice}</b><span class="option-check"><Check size={17} /></span>
              </label>
            </div>

            <div class="included-note"><Info size={20} stroke-width={1.8} aria-hidden="true" /><span><strong>{t.included}</strong> {t.includedCopy}</span></div>
            <div class="step-actions">
              <button class="action secondary" type="button" data-prev-step><ChevronLeft size={18} aria-hidden="true" /> {t.backButton}</button>
              <button class="action primary" type="button" data-next-step>{t.continue} <ChevronRight size={18} aria-hidden="true" /></button>
            </div>
          </section>

          <section class="form-step" data-step="2" aria-labelledby="step-title-2">
            <header class="step-header">
              <span class="step-number">03</span>
              <div><h2 id="step-title-2">{t.step2Title}</h2><p>{t.step2Copy}</p></div>
            </header>

            <div class="field-grid two-cols">
              <label class="field"><span>{t.firstName}</span><input id="first-name" name="prenom" autocomplete="given-name" required /></label>
              <label class="field"><span>{t.lastName}</span><input id="last-name" name="nom" autocomplete="family-name" required /></label>
              <label class="field full"><span>{t.address}</span><input id="address-field" name="adresse" autocomplete="street-address" required /></label>
              <label class="field postal-field"><span>{t.postal}</span><input id="postal-field" name="npa" inputmode="numeric" autocomplete="postal-code" maxlength="6" required /></label>
              <label class="field"><span>{t.city}</span><input id="city-field" name="localite" autocomplete="address-level2" required /></label>
              <label class="field"><span>{t.phone}</span><input id="phone-field" name="telephone" type="tel" autocomplete="tel" required /></label>
              <label class="field"><span>{t.email}</span><input id="email-field" name="email" type="email" autocomplete="email" /></label>
              <label class="field full">
                <span>{t.iban}</span>
                <input id="client-iban" name="iban_client" inputmode="text" autocomplete="off" placeholder="CH00 0000 0000 0000 0000 0" aria-describedby="iban-help" />
                <small id="iban-help">{t.ibanHelp}</small>
              </label>
              <label class="field full"><span>{t.remarks}</span><textarea id="remarks-field" name="remarques" rows="4"></textarea></label>
            </div>

            <p id="error-step-2" class="step-error" data-error-step="2" role="alert"></p>
            <div class="step-actions">
              <button class="action secondary" type="button" data-prev-step><ChevronLeft size={18} aria-hidden="true" /> {t.backButton}</button>
              <button class="action primary" type="button" data-next-step>{t.continue} <ChevronRight size={18} aria-hidden="true" /></button>
            </div>
          </section>

          <section class="form-step" data-step="3" aria-labelledby="step-title-3">
            <header class="step-header">
              <span class="step-number">04</span>
              <div><h2 id="step-title-3">{t.step3Title}</h2><p>{t.step3Copy}</p></div>
            </header>

            <ol class="conditions-list">
              {rentalConditions.map((condition, index) => (
                <li class="condition-row">
                  <span class="condition-number">{String(index + 1).padStart(2, '0')}</span>
                  <p><strong>{condition.title} :</strong> {condition.text}</p>
                </li>
              ))}
            </ol>

            <label class="acceptance-row">
              <input id="conditions-accept" name="conditions_accept" type="checkbox" />
              <span>
                <strong>{t.accept}</strong>
                <small>{t.acceptHelp}</small>
              </span>
            </label>

            <div class="signature-field">
              <div class="signature-head">
                <div><strong>{t.signature}</strong><span>{t.signatureDraw}</span></div>
                <button id="clear-signature" type="button"><RotateCcw size={16} aria-hidden="true" /> {t.clear}</button>
              </div>
              <canvas id="signature-canvas" width="1000" height="220" aria-label={t.signatureCanvas}>
                {t.signatureFallback}
              </canvas>
            </div>

            <label class="field signature-alternative">
              <span>{t.signatureAlternative}</span>
              <input id="signature-text" name="signature_text" autocomplete="name" aria-describedby="signature-help" />
              <small id="signature-help">{t.signatureHelp}</small>
            </label>

            <p id="error-step-3" class="step-error" data-error-step="3" role="alert"></p>
            <div class="step-actions">
              <button class="action secondary" type="button" data-prev-step><ChevronLeft size={18} aria-hidden="true" /> {t.backButton}</button>
              <button class="action primary" type="button" data-next-step>{t.verify} <ChevronRight size={18} aria-hidden="true" /></button>
            </div>
          </section>

          <section class="form-step recap-step" data-step="4" aria-labelledby="step-title-4">
            <header class="print-contract-header">
              <img src="/logo-transparent.png" width="72" height="72" alt={t.logoAlt} />
              <div>
                <span>Amicale Du Stand · Prêles</span>
                <h1>{t.contract}</h1>
                <p>Stand ADS · 2515 Prêles · Plateau de Diesse</p>
              </div>
              <dl>
                <div><dt>{t.rentalDate}</dt><dd id="print-header-date">–</dd></div>
                <div><dt>{t.preparedOn}</dt><dd id="print-created-date">–</dd></div>
              </dl>
            </header>

            <header class="step-header">
              <span class="step-number">05</span>
              <div><h2 id="step-title-4">{t.step4Title}</h2><p>{t.step4Copy}</p></div>
            </header>

            <div class="recap-grid">
              <section class="recap-block">
                <h3>{t.rental}</h3>
                <dl><div><dt>{t.date}</dt><dd id="recap-date">–</dd></div><div><dt>{t.periodLabel}</dt><dd id="recap-period">–</dd></div><div><dt>{t.participants}</dt><dd id="recap-people">–</dd></div></dl>
              </section>
              <section class="recap-block">
                <h3>{t.tenant}</h3>
                <dl><div><dt>{t.responsible}</dt><dd id="recap-name">–</dd></div><div><dt>{t.address.replace(' *', '')}</dt><dd id="recap-address">–</dd></div><div><dt>{t.contact}</dt><dd id="recap-contact">–</dd></div><div id="recap-iban-row"><dt>{t.depositIban}</dt><dd id="recap-iban">–</dd></div><div id="recap-remarks-row"><dt>{t.remarks}</dt><dd id="recap-remarks">–</dd></div></dl>
              </section>
              <section class="recap-block full"><h3>{t.options}</h3><ul id="recap-options"></ul></section>
              <section class="payment-box recap-payment">
                <div><span>{t.afterApproval}</span><strong>{t.paymentInfo}</strong></div>
                <div class="payment-total"><span>{t.calculatedTotal}</span><strong id="recap-total">CHF –</strong></div>
              </section>
              <section class="recap-block full print-conditions">
                <h3>{t.acceptedConditions}</h3>
                <ol>
                  {rentalConditions.map((condition, index) => (
                    <li><span>{index + 1}.</span><p><strong>{condition.title} :</strong> {condition.text}</p></li>
                  ))}
                </ol>
              </section>
              <section class="recap-block full signature-recap">
                <div>
                  <h3>{t.signatureAcceptance}</h3>
                  <p>{t.signerConfirmsBefore} <strong id="recap-signer">–</strong> {t.signerConfirmsAfter}</p>
                </div>
                <img id="recap-signature" alt={t.handwrittenAlt} />
                <p id="recap-signature-text" class="typed-signature hidden"></p>
              </section>
            </div>
            <div class="send-note"><Mail size={22} stroke-width={1.8} aria-hidden="true" /><p>{t.sendNoteBefore} <strong>{t.managerName}</strong> · <a href="mailto:gerante@ads-preles.ch">gerante@ads-preles.ch</a>.</p></div>
            <div class="step-actions recap-actions">
              <button class="action secondary" type="button" data-prev-step><ChevronLeft size={18} aria-hidden="true" /> {t.edit}</button>
              <button id="email-contract" class="action secondary" type="button"><Mail size={18} aria-hidden="true" /> {t.prepareEmail}</button>
              <button id="print-contract" class="action primary" type="button"><Printer size={18} aria-hidden="true" /> {t.printPdf}</button>
            </div>

            <footer class="print-contract-footer">
              <strong>{t.management} · {t.managerName}</strong>
              <span>078 638 47 91 · gerante@ads-preles.ch</span>
              <span>Stand ADS · 2515 Prêles</span>
            </footer>
          </section>
        </form>

        <aside class="booking-sidebar">
          <section class="summary-card">
            <header><p class="booking-eyebrow">{t.summary}</p><h2>{t.yourRental}</h2><span id="summary-date">{t.noDate}</span></header>
            <dl>
              <div><dt>{t.periodLabel}</dt><dd id="summary-period">–</dd></div>
              <div><dt>{t.persons}</dt><dd id="summary-people">20</dd></div>
              <div><dt>{t.baseRental}</dt><dd id="summary-base">–</dd></div>
              <div><dt>{t.options}</dt><dd id="summary-options">CHF 0.–</dd></div>
              <div id="summary-discount-row" class="discount-row hidden"><dt>{t.memberDiscount}</dt><dd id="summary-discount">–</dd></div>
            </dl>
            <div class="summary-total"><span>{t.indicativeTotal}</span><strong id="summary-total">CHF –</strong></div>
            <p>{t.finalAmount}</p>
          </section>
          <section class="manager-card">
            <p class="booking-eyebrow">{t.contact}</p><h3>{t.managerName}</h3>
            <a href="tel:+41786384791"><Phone size={17} aria-hidden="true" />078 638 47 91</a>
            <a href="mailto:gerante@ads-preles.ch"><Mail size={17} aria-hidden="true" />gerante@ads-preles.ch</a>
          </section>
        </aside>
      </div>
    </section>

    <section class="availability-section" aria-labelledby="availability-title">
      <div class="reservation-shell">
        <div class="availability-heading">
          <div>
            <p class="booking-eyebrow">{t.availability}</p>
            <h2 id="availability-title">{t.calendarTitle}</h2>
          </div>
          <p>{t.calendarLead}</p>
        </div>

        <div class="availability-layout">
          <div class="availability-calendar-panel">
            <AvailabilityCalendar
              bookedDates={availability.bookedDates}
              available={availability.available}
              locale={locale}
              bookingPath={pagePaths.reservation[locale]}
            />
          </div>

          <aside class="availability-guide" aria-label={t.guideLabel}>
            <div>
              <p class="booking-eyebrow">{t.howTo}</p>
              <h3>{t.guideTitle}</h3>
            </div>
            <ol>
              {t.guide.map(([strong, rest], index) => <li><span>{String(index + 1).padStart(2, '0')}</span><p><strong>{strong}</strong> {rest}</p></li>)}
            </ol>
            <div class="availability-note" role="note">
              <Info size={20} stroke-width={1.8} aria-hidden="true" />
              <p>
                {t.confirmation}
                {syncedLabel && <small>{t.updated} {syncedLabel}.</small>}
              </p>
              <a href={googleCalendarUrl} target="_blank" rel="noopener noreferrer">
                {t.openGoogle}
              </a>
            </div>
          </aside>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter locale={locale} />
</MainLayout>

<script>
  type Period = 'journee' | 'soiree' | 'complet' | 'consecutif';

  const byId = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const bookingRoot = byId<HTMLElement>('main-content');
  const i18n = JSON.parse(bookingRoot.dataset.runtimeI18n ?? '{}') as Record<string, any>;
  const localeCode = bookingRoot.dataset.localeCode ?? 'fr-CH';
  const steps = Array.from(document.querySelectorAll<HTMLElement>('.form-step'));
  const progressSteps = Array.from(document.querySelectorAll<HTMLButtonElement>('.progress-step'));
  const periodCards = Array.from(document.querySelectorAll<HTMLButtonElement>('.period-card'));
  const dateField = byId<HTMLInputElement>('date-field');
  const dateAvailabilityFeedback = byId<HTMLElement>('date-availability-feedback');
  const calendarRoot = document.querySelector<HTMLElement>('[data-availability-calendar]');
  const calendarAvailable = calendarRoot?.dataset.calendarAvailable === 'true';
  const bookedDates = new Set<string>(JSON.parse(calendarRoot?.dataset.booked ?? '[]'));
  const holidayField = byId<HTMLInputElement>('holiday-field');
  const daysField = byId<HTMLInputElement>('days-field');
  const daysGroup = byId<HTMLElement>('days-group');
  const peopleField = byId<HTMLInputElement>('people-field');
  const memberField = byId<HTMLInputElement>('member-field');
  const cautionRow = byId<HTMLElement>('caution-row');
  const cautionStatus = byId<HTMLElement>('caution-status');
  const clientIbanField = byId<HTMLInputElement>('client-iban');
  const ibanHelp = byId<HTMLElement>('iban-help');
  const pizzaField = byId<HTMLInputElement>('pizza-field');
  const woodField = byId<HTMLInputElement>('wood-field');
  const cleaningField = byId<HTMLInputElement>('cleaning-field');
  const conditionsAccept = byId<HTMLInputElement>('conditions-accept');
  const canvas = byId<HTMLCanvasElement>('signature-canvas');
  const signatureTextField = byId<HTMLInputElement>('signature-text');
  const context = canvas.getContext('2d');

  let currentStep = 0;
  let maxReached = 0;
  let selectedPeriod: Period | null = null;
  let signatureStarted = false;
  let signaturePoints = 0;
  let drawing = false;

  const periodLabels: Record<Period, string> = {
    journee: i18n.periodLabels[0],
    soiree: i18n.periodLabels[1],
    complet: i18n.periodLabels[2],
    consecutif: i18n.periodLabels[3],
  };

  const localToday = () => {
    const now = new Date();
    return [now.getFullYear(), String(now.getMonth() + 1).padStart(2, '0'), String(now.getDate()).padStart(2, '0')].join('-');
  };

  const isWeekendRate = () => {
    if (holidayField.checked) return true;
    if (!dateField.value) return false;
    const date = new Date(`${dateField.value}T12:00:00`);
    return date.getDay() === 0 || date.getDay() === 6;
  };

  const formatDate = (value: string) => {
    if (!value) return '–';
    return new Intl.DateTimeFormat(localeCode).format(new Date(`${value}T12:00:00`));
  };

  const formatAmount = (value: number) => `CHF ${value.toFixed(2)}`;

  const addDays = (value: string, days: number) => {
    const date = new Date(`${value}T12:00:00`);
    date.setDate(date.getDate() + days);
    return [date.getFullYear(), String(date.getMonth() + 1).padStart(2, '0'), String(date.getDate()).padStart(2, '0')].join('-');
  };

  const conflictingDate = () => {
    if (!calendarAvailable || !dateField.value) return null;
    const length = selectedPeriod === 'consecutif' ? Math.max(3, Number(daysField.value) || 3) : 1;
    for (let offset = 0; offset < length; offset += 1) {
      const date = addDays(dateField.value, offset);
      if (bookedDates.has(date)) return date;
    }
    return null;
  };

  const updateDateAvailability = () => {
    const conflict = conflictingDate();
    dateField.setCustomValidity(conflict ? i18n.conflict : '');
    dateAvailabilityFeedback.textContent = conflict
      ? `${formatDate(conflict)} ${selectedPeriod === 'consecutif' ? i18n.conflictPeriod : i18n.conflictSingle}`
      : calendarAvailable
        ? i18n.available
        : i18n.unavailable;
    dateAvailabilityFeedback.classList.toggle('date-conflict', Boolean(conflict));
  };

  const calculate = () => {
    if (!selectedPeriod) return null;
    const weekend = isWeekendRate();
    const days = Math.max(3, Number(daysField.value) || 3);
    let base = 0;
    if (selectedPeriod === 'consecutif') base = days * 160;
    if (selectedPeriod === 'complet') base = weekend ? 190 : 150;
    if (selectedPeriod === 'journee' || selectedPeriod === 'soiree') base = 90;
    const discount = memberField.checked ? base * 0.2 : 0;
    const options = (!memberField.checked ? 150 : 0) + (pizzaField.checked ? 50 : 0) + (woodField.checked ? 30 : 0);
    return { base, discount, options, total: base - discount + options };
  };

  const updateSummary = () => {
    byId('summary-date').textContent = dateField.value ? formatDate(dateField.value) : i18n.noDate;
    byId('summary-period').textContent = selectedPeriod ? periodLabels[selectedPeriod] : '–';
    byId('summary-people').textContent = `${peopleField.value || 1} ${i18n.personShort}`;
    const result = calculate();
    byId('summary-base').textContent = result ? formatAmount(result.base) : '–';
    byId('summary-options').textContent = result ? formatAmount(result.options) : 'CHF 0.00';
    byId('summary-total').textContent = result ? formatAmount(result.total) : 'CHF –';
    const discountRow = byId('summary-discount-row');
    discountRow.classList.toggle('hidden', !result || result.discount === 0);
    byId('summary-discount').textContent = result ? `− ${formatAmount(result.discount)}` : '–';
  };

  const updatePeriodAvailability = () => {
    const weekend = isWeekendRate();
    periodCards.forEach((card) => {
      const period = card.dataset.period as Period;
      const disabled = weekend && (period === 'journee' || period === 'soiree');
      card.disabled = disabled;
      card.classList.toggle('disabled', disabled);
      if (disabled && selectedPeriod === period) {
        selectedPeriod = null;
        card.classList.remove('selected');
      }
    });
    const completePrice = document.querySelector<HTMLElement>('[data-price="complet"]');
    if (completePrice) completePrice.textContent = weekend ? 'CHF 190.–' : 'CHF 150.–';
    updateDateAvailability();
    updateSummary();
  };

  const showStep = (index: number, moveFocus = false) => {
    currentStep = Math.max(0, Math.min(index, steps.length - 1));
    maxReached = Math.max(maxReached, currentStep);
    steps.forEach((step, i) => step.classList.toggle('active', i === currentStep));
    progressSteps.forEach((step, i) => {
      step.classList.toggle('active', i === currentStep);
      step.classList.toggle('done', i < currentStep);
      step.disabled = i > maxReached;
      if (i === currentStep) step.setAttribute('aria-current', 'step');
      else step.removeAttribute('aria-current');
    });
    if (currentStep === 4) renderRecap();
    document.querySelector('.progress')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    if (moveFocus) {
      const heading = steps[currentStep]?.querySelector<HTMLElement>('h2');
      heading?.setAttribute('tabindex', '-1');
      window.setTimeout(() => heading?.focus(), 250);
    }
  };

  const setStepError = (step: number, message: string) => {
    const target = document.querySelector<HTMLElement>(`[data-error-step="${step}"]`);
    if (target) target.textContent = message;
  };

  const clearStepError = (step: number) => {
    setStepError(step, '');
    const errorId = `error-step-${step}`;
    steps[step]?.querySelectorAll<HTMLElement>('[aria-invalid="true"]').forEach((control) => {
      control.removeAttribute('aria-invalid');
      const describedBy = (control.getAttribute('aria-describedby') ?? '')
        .split(/\s+/)
        .filter((id) => id && id !== errorId);
      if (describedBy.length > 0) control.setAttribute('aria-describedby', describedBy.join(' '));
      else control.removeAttribute('aria-describedby');
    });
  };

  const invalidate = (step: number, control: HTMLElement, message: string) => {
    const errorId = `error-step-${step}`;
    setStepError(step, message);
    control.setAttribute('aria-invalid', 'true');
    const describedBy = new Set((control.getAttribute('aria-describedby') ?? '').split(/\s+/).filter(Boolean));
    describedBy.add(errorId);
    control.setAttribute('aria-describedby', [...describedBy].join(' '));
    control.focus();
    return false;
  };

  const validateStep = (step: number) => {
    clearStepError(step);
    if (step === 0) {
      if (!dateField.value) return invalidate(step, dateField, i18n.selectDate);
      const conflict = conflictingDate();
      if (conflict) return invalidate(step, dateField, `${i18n.dateBookedBefore} ${formatDate(conflict)} ${i18n.dateBookedAfter}`);
      if (!selectedPeriod) {
        const firstPeriod = periodCards.find((card) => !card.disabled) ?? periodCards[0];
        return invalidate(step, firstPeriod, i18n.selectPeriod);
      }
      if (selectedPeriod === 'consecutif' && Number(daysField.value) < 3) return invalidate(step, daysField, i18n.minimumDays);
      if (Number(peopleField.value) < 1 || Number(peopleField.value) > 70) return invalidate(step, peopleField, i18n.peopleRange);
    }
    if (step === 2) {
      const required = ['first-name', 'last-name', 'address-field', 'postal-field', 'city-field', 'phone-field'].map((id) => byId<HTMLInputElement>(id));
      const missing = required.find((field) => !field.value.trim());
      if (missing) return invalidate(step, missing, i18n.required);
      const email = byId<HTMLInputElement>('email-field');
      if (email.value && !email.checkValidity()) return invalidate(step, email, i18n.validEmail);
      if (!memberField.checked && !clientIbanField.value.trim()) return invalidate(step, clientIbanField, i18n.ibanRequired);
    }
    if (step === 3) {
      if (!conditionsAccept.checked) return invalidate(step, conditionsAccept, i18n.acceptRequired);
      if ((!signatureStarted || signaturePoints < 5) && !signatureTextField.value.trim()) {
        return invalidate(step, signatureTextField, i18n.signatureRequired);
      }
    }
    return true;
  };

  const optionTexts = () => {
    const options: string[] = [];
    if (memberField.checked) options.push(i18n.optionMember);
    if (!memberField.checked) options.push(i18n.optionDeposit);
    if (pizzaField.checked) options.push(i18n.optionPizza);
    if (woodField.checked) options.push(i18n.optionWood);
    options.push(cleaningField.checked ? i18n.cleaningTenant : i18n.cleaningInvoice);
    return options;
  };

  const renderRecap = () => {
    const firstName = byId<HTMLInputElement>('first-name').value.trim();
    const lastName = byId<HTMLInputElement>('last-name').value.trim();
    const address = byId<HTMLInputElement>('address-field').value.trim();
    const postal = byId<HTMLInputElement>('postal-field').value.trim();
    const city = byId<HTMLInputElement>('city-field').value.trim();
    const phone = byId<HTMLInputElement>('phone-field').value.trim();
    const email = byId<HTMLInputElement>('email-field').value.trim();
    const iban = clientIbanField.value.trim();
    const remarks = byId<HTMLTextAreaElement>('remarks-field').value.trim();
    const days = Math.max(3, Number(daysField.value) || 3);
    byId('recap-date').textContent = formatDate(dateField.value);
    byId('recap-period').textContent = selectedPeriod ? `${periodLabels[selectedPeriod]}${selectedPeriod === 'consecutif' ? ` · ${days} ${i18n.daysWord}` : ''}` : '–';
    byId('recap-people').textContent = `${peopleField.value} ${i18n.peopleWord}`;
    byId('recap-name').textContent = `${firstName} ${lastName}`.trim();
    byId('recap-signer').textContent = `${firstName} ${lastName}`.trim();
    byId('print-header-date').textContent = formatDate(dateField.value);
    byId('print-created-date').textContent = new Intl.DateTimeFormat(localeCode).format(new Date());
    byId('recap-address').textContent = `${address}, ${postal} ${city}`;
    byId('recap-contact').textContent = [phone, email].filter(Boolean).join(' · ');
    byId('recap-iban').textContent = iban || i18n.notProvided;
    byId('recap-iban-row').classList.toggle('hidden', memberField.checked && !iban);
    byId('recap-remarks').textContent = remarks || i18n.noRemarks;
    byId('recap-remarks-row').classList.toggle('hidden', !remarks);
    const optionList = byId<HTMLUListElement>('recap-options');
    optionList.replaceChildren();
    optionTexts().forEach((text) => { const item = document.createElement('li'); item.textContent = text; optionList.append(item); });
    const result = calculate();
    byId('recap-total').textContent = result ? formatAmount(result.total) : 'CHF –';
    const recapSignature = byId<HTMLImageElement>('recap-signature');
    const recapSignatureText = byId<HTMLElement>('recap-signature-text');
    const typedSignature = signatureTextField.value.trim();
    recapSignature.classList.toggle('hidden', Boolean(typedSignature));
    recapSignatureText.classList.toggle('hidden', !typedSignature);
    recapSignatureText.textContent = typedSignature;
    if (!typedSignature) recapSignature.src = canvas.toDataURL('image/png');
  };

  const signaturePosition = (event: PointerEvent) => {
    const rect = canvas.getBoundingClientRect();
    return { x: (event.clientX - rect.left) * (canvas.width / rect.width), y: (event.clientY - rect.top) * (canvas.height / rect.height) };
  };

  canvas.addEventListener('pointerdown', (event) => {
    if (!context) return;
    drawing = true; signatureStarted = true; signaturePoints = 1; canvas.setPointerCapture(event.pointerId);
    const point = signaturePosition(event); context.beginPath(); context.moveTo(point.x, point.y);
  });
  canvas.addEventListener('pointermove', (event) => {
    if (!context || !drawing) return;
    const point = signaturePosition(event); signaturePoints += 1; context.lineTo(point.x, point.y);
    context.strokeStyle = '#123c36'; context.lineWidth = 4; context.lineCap = 'round'; context.lineJoin = 'round'; context.stroke();
  });
  const stopDrawing = () => { drawing = false; };
  canvas.addEventListener('pointerup', stopDrawing);
  canvas.addEventListener('pointercancel', stopDrawing);
  byId('clear-signature').addEventListener('click', () => { context?.clearRect(0, 0, canvas.width, canvas.height); signatureStarted = false; signaturePoints = 0; });

  periodCards.forEach((card) => {
    card.addEventListener('click', () => {
      if (card.disabled) return;
      selectedPeriod = card.dataset.period as Period;
      periodCards.forEach((item) => { const selected = item === card; item.classList.toggle('selected', selected); item.setAttribute('aria-pressed', String(selected)); });
      daysGroup.classList.toggle('hidden', selectedPeriod !== 'consecutif');
      updateDateAvailability();
      updateSummary();
    });
  });

  document.querySelectorAll<HTMLButtonElement>('[data-counter]').forEach((button) => {
    button.addEventListener('click', () => {
      const next = Number(peopleField.value || 1) + Number(button.dataset.counter || 0);
      peopleField.value = String(Math.max(1, Math.min(70, next)));
      updateSummary();
    });
  });

  const updateCautionState = () => {
    const applies = !memberField.checked;
    cautionRow.classList.toggle('applied', applies);
    cautionRow.classList.toggle('waived', !applies);
    cautionStatus.textContent = applies ? i18n.depositApplied : i18n.depositWaived;
    clientIbanField.required = applies;
    ibanHelp.textContent = applies
      ? i18n.ibanRequired
      : i18n.ibanMember;
  };

  document.querySelectorAll<HTMLInputElement>('.option-row input').forEach((input) => {
    input.addEventListener('change', () => {
      if (input === memberField) updateCautionState();
      updateSummary();
    });
  });

  dateField.addEventListener('change', updatePeriodAvailability);
  holidayField.addEventListener('change', updatePeriodAvailability);
  daysField.addEventListener('input', () => { updateDateAvailability(); updateSummary(); });
  peopleField.addEventListener('input', updateSummary);
  document.querySelectorAll<HTMLButtonElement>('[data-next-step]').forEach((button) => button.addEventListener('click', () => { if (validateStep(currentStep)) showStep(currentStep + 1, true); }));
  document.querySelectorAll<HTMLButtonElement>('[data-prev-step]').forEach((button) => button.addEventListener('click', () => showStep(currentStep - 1, true)));
  progressSteps.forEach((button) => button.addEventListener('click', () => { const target = Number(button.dataset.goStep); if (target <= maxReached) showStep(target, true); }));
  byId('print-contract').addEventListener('click', () => window.print());
  byId('email-contract').addEventListener('click', () => {
    const name = `${byId<HTMLInputElement>('first-name').value} ${byId<HTMLInputElement>('last-name').value}`.trim();
    const period = selectedPeriod ? periodLabels[selectedPeriod] : '';
    const result = calculate();
    const subject = `${i18n.emailSubject} — ${formatDate(dateField.value)} — ${name}`;
    const body = [i18n.hello, '', i18n.attachment, '', `${i18n.date} : ${formatDate(dateField.value)}`, `${i18n.period} : ${period}`, `${i18n.people} : ${peopleField.value}`, `${i18n.total} : ${result ? formatAmount(result.total) : i18n.confirm}`, '', i18n.regards, name].join('\n');
    window.location.href = `mailto:gerante@ads-preles.ch?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  });

  dateField.min = localToday();
  const requestedDate = new URLSearchParams(window.location.search).get('date');
  if (requestedDate && /^\d{4}-\d{2}-\d{2}$/.test(requestedDate) && requestedDate >= localToday() && !bookedDates.has(requestedDate)) {
    dateField.value = requestedDate;
  }
  updateCautionState();
  showStep(0);
  updatePeriodAvailability();
</script>

