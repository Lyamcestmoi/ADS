---
import MainLayout from '../layouts/MainLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';

const title = 'Stand ADS Prêles — Location de salle · Plateau de Diesse';
const description =
  "Louez le Stand ADS à Prêles, sur le Plateau de Diesse. Salle pouvant accueillir jusqu'à 65 personnes, cheminée, four à pizza et vue sur le Chasseral.";
---

<MainLayout title={title} description={description}>
  <SiteHeader active="home" />

  <!-- HERO -->
  <div class="hero">
    <img src="/stand.png" alt="Stand ADS Prêles avec vue sur le Chasseral" class="hero-img">
    <div class="hero-overlay">
      <div class="hero-content">
        <div class="hero-eyebrow">📍 Prêles · Plateau de Diesse · Berne</div>
        <h1 class="hero-title">Le Stand <em>ADS</em><br>à Prêles</h1>
        <p class="hero-desc">Une salle conviviale au cœur du Plateau de Diesse, avec vue imprenable sur le Chasseral.
          Idéale pour vos fêtes, repas et rassemblements.</p>
        <div class="hero-actions">
          <a href="/reservation/" class="btn-hero btn-hero-primary">📋 Réserver en ligne</a>
          <a href="#infos" class="btn-hero btn-hero-ghost">En savoir plus ↓</a>
        </div>
      </div>
    </div>
  </div>

  <!-- STATS RIBBON -->
  <div class="stats-ribbon">
    <div class="stats-inner">
      <div class="stat-item">
        <div class="stat-num">65</div>
        <div class="stat-label">Places assises</div>
      </div>
      <div class="stat-item">
        <div class="stat-num">70</div>
        <div class="stat-label">Personnes (service)</div>
      </div>
      <div class="stat-item">
        <div class="stat-num">23h</div>
        <div class="stat-label">Location complète</div>
      </div>
      <div class="stat-item">
        <div class="stat-num">90.—</div>
        <div class="stat-label">Dès CHF / location</div>
      </div>
    </div>
  </div>

  <!-- INFOS -->
  <section id="infos" style="background: var(--off);">
    <div class="section-inner">
      <div class="reveal">
        <div class="section-label">Le stand</div>
        <h2 class="section-title">Tout ce qu'il faut savoir</h2>
        <p class="section-sub">Un espace complet et bien équipé pour vos événements, disponible à la location pour les
          membres ADS et le public.</p>
      </div>

      <div class="infos-grid reveal">

        <!-- équipements -->
        <div class="info-card">
          <div class="info-card-head">
            <span class="info-card-icon">🏠</span>
            <h3>Équipements inclus</h3>
          </div>
          <div class="info-card-body">
            <ul class="feat-list">
              <li>~65 places assises à l'intérieur</li>
              <li>Cuisine équipée : vitrocéramique, frigo, four, micro-onde</li>
              <li>Vaisselle pour environ 50 personnes</li>
              <li>Cheminée intérieure avec possibilité de griller</li>
              <li>Cheminée extérieure et table pour ~10 pers.</li>
              <li>4 portes vitrées avec accès extérieur</li>
              <li>Eau courante · électricité · WC</li>
              <li>1 caddie de bois inclus dans la location</li>
              <li>Zone de parcage délimitée</li>
            </ul>
          </div>
        </div>

        <!-- tarifs -->
        <div style="display: flex; flex-direction: column; gap: 20px;">
          <div class="info-card">
            <div class="info-card-head">
              <span class="info-card-icon">💰</span>
              <h3>Tarifs</h3>
            </div>
            <div class="info-card-body">
              <div class="tarif-row">
                <span class="t-name">Journée / Soirée (lun–jeu)</span>
                <span class="t-price">90.—</span>
              </div>
              <div class="tarif-row">
                <span class="t-name">Jour complet ~23h (lun–jeu)</span>
                <span class="t-price">150.—</span>
              </div>
              <div class="tarif-row">
                <span class="t-name">Jour complet week-end / fériés</span>
                <span class="t-price">190.—</span>
              </div>
              <div class="tarif-row">
                <span class="t-name">≥ 3 jours consécutifs / jour</span>
                <span class="t-price">120.—</span>
              </div>
              <div class="tarif-row" style="border-top: 2px solid var(--green-mid); margin-top:6px; padding-top:10px;">
                <span class="t-name" style="color:var(--green-dark); font-weight:700;">Membres ADS</span>
                <span class="t-price" style="color:var(--accent);">− 20 %</span>
              </div>
              <p class="tarif-note">Caution CHF 150.— pour les non-membres · remboursée à la reddition</p>
            </div>
          </div>

          <div class="info-card">
            <div class="info-card-head">
              <span class="info-card-icon">⚙️</span>
              <h3>Options disponibles</h3>
            </div>
            <div class="info-card-body">
              <div class="tarif-row">
                <span class="t-name">🍕 Four à pizza</span>
                <span class="t-price">+ 50.—</span>
              </div>
              <div class="tarif-row">
                <span class="t-name">🪵 Bois suppl. (hiver)</span>
                <span class="t-price">+ 30.—</span>
              </div>
              <div class="tarif-row">
                <span class="t-name">🧹 Nettoyage (si non fait)</span>
                <span class="t-price">50.—/h</span>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- CTA -->
  <div class="cta-section">
    <div class="cta-inner">
      <div class="cta-text">
        <h2>Prêt à réserver le stand ?</h2>
        <p>Remplissez le contrat de location en ligne, la gérance vous confirmera la disponibilité. Votre réservation
          est validée après réception du paiement.</p>
      </div>
      <a href="/reservation/" class="btn-cta">📋 Accéder au formulaire →</a>
    </div>
  </div>

  <!-- COMING SOON -->
  <section style="background: var(--off);">
    <div class="section-inner">
      <div class="reveal">
        <div class="section-label">À venir</div>
        <h2 class="section-title">Prochainement sur ce site</h2>
        <p class="section-sub">Ces sections sont en cours de préparation et seront disponibles prochainement.</p>
      </div>
      <div class="coming-grid reveal">

        <div class="coming-card">
          <div class="coming-icon">👥</div>
          <div class="coming-title">Le Comité ADS</div>
          <div class="coming-desc">Présentation des membres du comité de l'Amicale Du Stand, leurs rôles et coordonnées.
          </div>
          <div class="coming-items">
            <span>Présidents</span>
            <span>Membres</span>
            <span>Gérance</span>
          </div>
        </div>

        <div class="coming-card">
          <div class="coming-icon">🖼</div>
          <div class="coming-title">Galerie Photos</div>
          <div class="coming-desc">Découvrez le stand en images : l'intérieur, les événements passés, la vue sur le
            Chasseral.</div>
          <div class="coming-items">
            <span>Intérieur</span>
            <span>Extérieur</span>
            <span>Événements</span>
          </div>
        </div>

        <div class="coming-card">
          <div class="coming-icon">📋</div>
          <div class="coming-title">Infos Pratiques</div>
          <div class="coming-desc">Pense-bête complet, ce qu'il faut apporter, les règles d'utilisation et le calendrier
            des réservations.</div>
          <div class="coming-items">
            <span>Pense-bête</span>
            <span>Calendrier</span>
            <span>Accès</span>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section style="background: var(--white);">
    <div class="section-inner">
      <div class="reveal">
        <div class="section-label">Contact</div>
        <h2 class="section-title">Nous contacter</h2>
        <p class="section-sub">Pour toute réservation ou renseignement, contactez directement la gérance.</p>
      </div>
      <div class="contact-grid reveal">

        <div class="contact-box">
          <h4>📋 Gérance & Réservations</h4>
          <div class="contact-line"><span class="ci">👤</span>
            <div><strong>Daniela Allemann</strong><br><span>Chemin Neuf 1, 2517 Diesse</span></div>
          </div>
          <div class="contact-line"><span class="ci">📞</span><a href="tel:0786384791">078 638 47 91</a></div>
          <div class="contact-line"><span class="ci">✉</span><a
              href="mailto:dani.alle57@gmail.com">dani.alle57@gmail.com</a></div>
        </div>

        <div class="contact-box">
          <h4>💰 Finances</h4>
          <div class="contact-line"><span class="ci">👤</span>
            <div><strong>Valérie Jeanguenin</strong></div>
          </div>
          <div class="contact-line"><span class="ci">📞</span><a href="tel:0796464572">079 646 45 72</a></div>
          <div class="contact-line"><span class="ci">✉</span><a
              href="mailto:valerie.jeanguenin@gmail.com">valerie.jeanguenin@gmail.com</a></div>
          <div class="contact-line" style="margin-top:10px;"><span class="ci">🏦</span>
            <div><span>IBAN : </span><strong style="font-family:monospace; font-size:12px;">CH37 0900 0000 1711 4870
                5</strong></div>
          </div>
        </div>

        <div class="contact-box">
          <h4>📍 Accès au stand</h4>
          <div class="contact-line"><span class="ci">📌</span>
            <div><strong>Stand ADS</strong><br><span>2515 Prêles</span><br><span>Plateau de Diesse, BE</span></div>
          </div>
          <a href="https://maps.google.com/?q=Stand+ADS+Prêles+2515" target="_blank" class="map-placeholder"
            style="margin-top:14px;">
            <div class="map-icon">🗺</div>
            <span>Ouvrir dans Google Maps</span>
            <small>Stand ADS · Prêles · 2515</small>
          </a>
        </div>

      </div>
    </div>
  </section>


  <SiteFooter />

  <script>
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) entry.target.classList.add('visible');
        });
      },
      { threshold: 0.1 },
    );

    document
      .querySelectorAll('.reveal')
      .forEach((element) => observer.observe(element));
  </script>
</MainLayout>
