---
import { ArrowRight, ArrowUpRight, Check, MapPin, Phone } from '@lucide/astro';
import MainLayout from '../layouts/MainLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';

const title = 'Location du Stand ADS à Prêles — Plateau de Diesse';
const description =
  'Informations, équipements et tarifs pour la location du Stand ADS à Prêles.';

const equipment = [
  'Environ 65 places assises à l’intérieur',
  'Capacité de service jusqu’à 70 personnes',
  'Cuisine équipée : vitrocéramique, frigo, four et micro-ondes',
  'Vaisselle pour environ 50 personnes',
  'Cheminée intérieure avec possibilité de griller',
  'Cheminée extérieure et table pour environ 10 personnes',
  'Quatre portes vitrées avec accès extérieur',
  'Eau courante, électricité et WC',
  'Un caddie de bois inclus dans la location',
  'Zone de parcage délimitée',
];
---

<MainLayout title={title} description={description}>
  <SiteHeader active="home" />

  <main>
    <section class="home-hero" aria-labelledby="hero-title">
      <img
        class="hero-media"
        src="/stand-hero.webp"
        width="1672"
        height="941"
        alt="Le Stand ADS à Prêles et son environnement naturel"
        fetchpriority="high"
      />
      <div class="hero-shade" aria-hidden="true"></div>

      <div class="hero-main shell">
        <p class="kicker">Prêles · Plateau de Diesse</p>
        <h1 id="hero-title" class="hero-title">
          Le Stand ADS<br />
          <em>à Prêles.</em>
        </h1>
        <p class="hero-copy">
          Le stand peut être loué pour un repas, une fête de famille ou une
          rencontre associative. Il compte environ 65 places assises.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="/reservation/">
            Faire une demande
            <ArrowRight size={18} stroke-width={1.8} aria-hidden="true" />
          </a>
          <a class="button button-ghost" href="#stand">Voir les équipements</a>
        </div>
      </div>

      <div class="hero-facts">
        <div class="facts-grid shell">
          <div class="fact"><strong>65 / 70</strong><span>places assises / personnes avec service</span></div>
          <div class="fact"><strong>≈ 23 h</strong><span>formule jour complet</span></div>
          <div class="fact"><strong>CHF 90</strong><span>tarif dès</span></div>
          <div class="fact"><strong>−20 %</strong><span>pour les membres ADS</span></div>
        </div>
      </div>
    </section>

    <section id="stand" class="section section-cream">
      <div class="shell">
        <div class="section-heading reveal">
          <div>
            <p class="eyebrow">Le stand</p>
            <h2 class="display-title">Équipements<br />et tarifs</h2>
          </div>
          <p class="section-lead">
            Le stand dispose d’une cuisine, de vaisselle, de deux cheminées et
            des installations nécessaires pour organiser votre événement.
          </p>
        </div>

        <div class="details-grid">
          <article class="detail-panel detail-panel-dark reveal">
            <header class="panel-head">
              <h3>Sur place</h3>
              <span class="panel-index">01</span>
            </header>
            <ul class="equipment-list">
              {equipment.map((item) => (
                <li>
                  <Check size={17} stroke-width={2} aria-hidden="true" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </article>

          <article id="tarifs" class="detail-panel reveal">
            <header class="panel-head">
              <h3>Tarifs de location</h3>
              <span class="panel-index">02</span>
            </header>
            <dl class="price-list">
              <div class="price-row">
                <dt>Lundi–jeudi · journée ou soirée</dt>
                <dd>CHF 90.–</dd>
              </div>
              <div class="price-row">
                <dt>Lundi–jeudi · jour complet</dt>
                <dd>CHF 150.–</dd>
              </div>
              <div class="price-row">
                <dt>Week-end ou jour férié</dt>
                <dd>CHF 190.–</dd>
              </div>
              <div class="price-row">
                <dt>Dès 3 jours · par jour</dt>
                <dd>CHF 120.–</dd>
              </div>
            </dl>
            <div class="price-notes">
              <span class="tag">Caution non-membre · CHF 150.–</span>
              <span class="tag tag-yellow">Membres ADS · −20 %</span>
            </div>
            <div class="options-list" aria-label="Options disponibles">
              <div class="option-item"><span>Four à pizza</span><strong>+ CHF 50.–</strong></div>
              <div class="option-item"><span>Bois</span><strong>+ CHF 30.–</strong></div>
              <div class="option-item"><span>Nettoyage</span><strong>CHF 50.– / h</strong></div>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section id="galerie" class="section gallery-section" aria-labelledby="gallery-title">
      <div class="shell">
        <div class="section-heading gallery-heading reveal">
          <div>
            <p class="eyebrow">Le stand en images</p>
            <h2 id="gallery-title" class="display-title">Une réception<br />au stand</h2>
          </div>
          <p class="section-lead">
            La salle et les extérieurs peuvent être aménagés selon l’événement.
            Voici un exemple de réception organisée au stand.
          </p>
        </div>

        <div class="gallery-grid reveal">
          <figure class="gallery-item gallery-item-tall">
            <img
              src="/event-exterieur.webp"
              width="646"
              height="1400"
              loading="lazy"
              decoding="async"
              alt="Extérieur du Stand ADS aménagé pour une réception"
            />
          </figure>
          <figure class="gallery-item gallery-item-wide">
            <img
              src="/event-ceremonie.webp"
              width="646"
              height="1400"
              loading="lazy"
              decoding="async"
              alt="Chaises installées à l’extérieur pour une cérémonie"
            />
          </figure>
          <figure class="gallery-item gallery-item-room">
            <img
              src="/event-salle.webp"
              width="646"
              height="1400"
              loading="lazy"
              decoding="async"
              alt="Salle du stand préparée avec de longues tables"
            />
          </figure>
          <figure class="gallery-item gallery-item-detail">
            <img
              src="/event-decoration.webp"
              width="1050"
              height="1400"
              loading="lazy"
              decoding="async"
              alt="Décoration florale disposée sur une table"
            />
          </figure>
          <figure class="gallery-item gallery-item-banner">
            <img
              src="/event-fleurs.webp"
              width="900"
              height="1200"
              loading="lazy"
              decoding="async"
              alt="Composition florale installée à l’extérieur du stand"
            />
          </figure>
        </div>

        <div class="gallery-subheading reveal">
          <h3>L’intérieur du stand</h3>
          <p>La salle, la cuisine, le bar et la cheminée.</p>
        </div>

        <div class="interior-gallery-grid reveal">
          <figure class="interior-photo interior-photo-wide">
            <img
              src="/interieur-table-bar.webp"
              width="1800"
              height="1350"
              loading="lazy"
              decoding="async"
              alt="Grande table dressée devant le bar du stand"
            />
          </figure>
          <figure class="interior-photo">
            <img
              src="/interieur-cheminee.webp"
              width="1800"
              height="1350"
              loading="lazy"
              decoding="async"
              alt="Cheminée intérieure du stand allumée"
            />
          </figure>
          <figure class="interior-photo">
            <img
              src="/interieur-cuisine.webp"
              width="1800"
              height="1350"
              loading="lazy"
              decoding="async"
              alt="Cuisine équipée derrière le bar"
            />
          </figure>
          <figure class="interior-photo">
            <img
              src="/interieur-table-1.webp"
              width="1800"
              height="1660"
              loading="lazy"
              decoding="async"
              alt="Table préparée le long de la salle"
            />
          </figure>
          <figure class="interior-photo">
            <img
              src="/interieur-table-2.webp"
              width="1722"
              height="1500"
              loading="lazy"
              decoding="async"
              alt="Autre disposition de la table dans la salle"
            />
          </figure>
          <figure class="interior-photo interior-photo-wide">
            <img
              src="/interieur-bar.webp"
              width="1800"
              height="1350"
              loading="lazy"
              decoding="async"
              alt="Bar et espace principal du stand"
            />
          </figure>
          <figure class="interior-photo interior-photo-wide">
            <img
              src="/interieur-salle.webp"
              width="1800"
              height="1350"
              loading="lazy"
              decoding="async"
              alt="Vue générale de la salle du stand"
            />
          </figure>
          <figure class="interior-photo">
            <img
              src="/interieur-cuisine-decoration.webp"
              width="1800"
              height="1460"
              loading="lazy"
              decoding="async"
              alt="Cuisine et décoration installée sur le bar"
            />
          </figure>
          <figure class="interior-photo">
            <img
              src="/interieur-grande-table.webp"
              width="1800"
              height="1350"
              loading="lazy"
              decoding="async"
              alt="Grande table dressée dans la salle"
            />
          </figure>
          <figure class="interior-photo interior-photo-banner">
            <img
              src="/interieur-cheminee-large.webp"
              width="1800"
              height="1350"
              loading="lazy"
              decoding="async"
              alt="Vue large de la cheminée intérieure"
            />
          </figure>
        </div>
      </div>
    </section>

    <section class="image-story" aria-label="Situation du Stand ADS">
      <figure>
        <img
          src="/stand.png"
          width="1200"
          height="900"
          loading="lazy"
          alt="Vue du Stand ADS dans le paysage de Prêles"
        />
      </figure>
      <div class="story-card">
        <div>
          <p class="eyebrow">Emplacement</p>
          <blockquote>À Prêles, avec vue sur le Chasseral.</blockquote>
        </div>
        <p>
          Le stand se trouve à Prêles, sur le Plateau de Diesse. Il peut accueillir
          des fêtes de famille, des repas et des rencontres d’association.
        </p>
      </div>
    </section>

    <section class="booking-band">
      <div class="booking-shell">
        <h2>Vous souhaitez louer le stand&nbsp;?</h2>
        <a class="button" href="/reservation/">
          Faire une demande
          <ArrowUpRight size={18} stroke-width={1.8} aria-hidden="true" />
        </a>
      </div>
    </section>

    <section id="contact" class="section">
      <div class="shell">
        <div class="contact-intro reveal">
          <p class="eyebrow">Contact</p>
          <h2 class="display-title">Contacter<br />la gérance</h2>
        </div>
        <div class="contact-grid reveal">
          <article class="contact-card">
            <span class="contact-number">01</span>
            <h3>Gérance & réservations</h3>
            <p><strong>Mme Daniela Allemann</strong><br />Pour les disponibilités, les réservations et les renseignements.</p>
            <a class="text-link" href="mailto:gerante@ads-preles.ch">
              gerante@ads-preles.ch
              <ArrowUpRight size={16} stroke-width={1.8} aria-hidden="true" />
            </a>
          </article>
          <article class="contact-card">
            <span class="contact-number">02</span>
            <h3>Téléphone</h3>
            <p>La gérance est également joignable par téléphone.</p>
            <a class="text-link" href="tel:+41786384791">
              <Phone size={16} stroke-width={1.8} aria-hidden="true" />
              078 638 47 91
            </a>
          </article>
          <article class="contact-card">
            <span class="contact-number">03</span>
            <h3>Accès</h3>
            <p>Stand ADS, 2515 Prêles, dans la commune du Plateau de Diesse.</p>
            <a
              class="text-link"
              href="https://www.google.com/maps/search/?api=1&query=Stand+ADS+Prêles"
              target="_blank"
              rel="noopener noreferrer"
            >
              <MapPin size={16} stroke-width={1.8} aria-hidden="true" />
              Ouvrir l’itinéraire
            </a>
          </article>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</MainLayout>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const elements = document.querySelectorAll<HTMLElement>('.reveal');

  if (reducedMotion || !('IntersectionObserver' in window)) {
    elements.forEach((element) => element.classList.add('visible'));
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.14 },
    );

    elements.forEach((element) => observer.observe(element));
  }
</script>
