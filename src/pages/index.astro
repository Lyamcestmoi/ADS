---
import {
  ArrowRight,
  ArrowUpRight,
  CalendarDays,
  Check,
  ChevronLeft,
  ChevronRight,
  MapPin,
  Phone,
  X,
} from '@lucide/astro';
import MainLayout from '../layouts/MainLayout.astro';
import AvailabilityCalendar from '../components/AvailabilityCalendar.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { getAvailability } from '../lib/availability';
import { commonTranslations, homeTranslations, pagePaths, type Locale } from '../lib/i18n';

interface Props { locale?: Locale; }
const { locale = 'fr' } = Astro.props;
const t = homeTranslations[locale];
const common = commonTranslations[locale];
const title = t.title;
const description = t.description;

const availability = await getAvailability();
---

<MainLayout title={title} description={description} locale={locale} alternatePaths={pagePaths.home}>
  <SiteHeader active="home" locale={locale} />

  <main id="main-content" tabindex="-1">
    <section class="home-hero" aria-labelledby="hero-title">
      <img
        class="hero-media"
        src="/stand-hero.webp"
        width="1672"
        height="941"
        alt={t.alts[0]}
        fetchpriority="high"
      />
      <div class="hero-shade" aria-hidden="true"></div>

      <div class="hero-main shell">
        <p class="kicker">{t.kicker}</p>
        <h1 id="hero-title" class="hero-title">
          {t.heroTitle}<br />
          <em>{t.heroEmphasis}</em>
        </h1>
        <p class="hero-copy">
          {t.heroCopy}
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href={pagePaths.reservation[locale]}>
            {common.reserve}
            <ArrowRight size={18} stroke-width={1.8} aria-hidden="true" />
          </a>
          <a class="button button-ghost" href="#stand">{t.equipmentButton}</a>
        </div>
      </div>

      <div class="hero-facts">
        <div class="facts-grid shell">
          {t.facts.map(([value, label]) => <div class="fact"><strong>{value}</strong><span>{label}</span></div>)}
        </div>
      </div>
    </section>

    <section class="home-availability" aria-labelledby="home-availability-title">
      <div class="shell home-availability-grid">
        <div class="home-availability-copy reveal">
          <span class="availability-icon"><CalendarDays size={25} stroke-width={1.7} aria-hidden="true" /></span>
          <p class="eyebrow">{t.availabilityEyebrow}</p>
          <h2 id="home-availability-title">{t.availabilityTitle}</h2>
          <p>{t.availabilityCopy}</p>
          <a class="button button-primary" href={pagePaths.reservation[locale]}>
            {t.availabilityButton}
            <ArrowRight size={18} stroke-width={1.8} aria-hidden="true" />
          </a>
        </div>
        <div class="home-calendar reveal">
          <AvailabilityCalendar
            bookedDates={availability.bookedDates}
            available={availability.available}
            compact
            locale={locale}
            bookingPath={pagePaths.reservation[locale]}
          />
        </div>
      </div>
    </section>

    <section id="interieur" class="section" aria-labelledby="interior-title">
      <div class="shell">
        <div class="section-heading gallery-heading reveal">
          <div>
            <p class="eyebrow">{t.interiorEyebrow}</p>
            <h2 id="interior-title" class="display-title">{t.interiorTitle}</h2>
          </div>
          <p class="section-lead">
            {t.interiorLead}
          </p>
        </div>

        <div class="interior-gallery-grid interior-gallery-preview reveal">
          <figure class="interior-photo interior-photo-wide">
            <img
              src="/interieur-table-bar.webp"
              width="1800"
              height="1350"
              loading="lazy"
              decoding="async"
              alt={t.alts[1]}
            />
          </figure>
          <figure class="interior-photo">
            <img
              src="/interieur-cheminee.webp"
              width="1800"
              height="1350"
              loading="lazy"
              decoding="async"
              alt={t.alts[2]}
            />
          </figure>
          <figure class="interior-photo">
            <img
              src="/interieur-cuisine.webp"
              width="1800"
              height="1350"
              loading="lazy"
              decoding="async"
              alt={t.alts[3]}
            />
          </figure>
          <figure class="interior-photo">
            <img
              src="/interieur-table-1.webp"
              width="1800"
              height="1660"
              loading="lazy"
              decoding="async"
              alt={t.alts[4]}
            />
          </figure>
        </div>
        <details class="interior-gallery-more reveal">
          <summary class="gallery-more-link">
            {t.viewAllPhotos}
            <ArrowRight size={18} stroke-width={1.8} aria-hidden="true" />
          </summary>
          <div class="interior-gallery-grid interior-gallery-extra">
            <figure class="interior-photo">
              <img src="/interieur-table-2.webp" width="1722" height="1500" loading="lazy" decoding="async" alt={t.alts[5]} />
            </figure>
            <figure class="interior-photo interior-photo-wide">
              <img src="/interieur-bar.webp" width="1800" height="1350" loading="lazy" decoding="async" alt={t.alts[6]} />
            </figure>
            <figure class="interior-photo interior-photo-wide">
              <img src="/interieur-salle.webp" width="1800" height="1350" loading="lazy" decoding="async" alt={t.alts[7]} />
            </figure>
            <figure class="interior-photo">
              <img src="/interieur-cuisine-decoration.webp" width="1800" height="1460" loading="lazy" decoding="async" alt={t.alts[8]} />
            </figure>
            <figure class="interior-photo">
              <img src="/interieur-grande-table.webp" width="1800" height="1350" loading="lazy" decoding="async" alt={t.alts[9]} />
            </figure>
            <figure class="interior-photo interior-photo-banner">
              <img src="/interieur-cheminee-large.webp" width="1800" height="1350" loading="lazy" decoding="async" alt={t.alts[10]} />
            </figure>
          </div>
        </details>
      </div>
    </section>

    <section id="stand" class="section section-cream">
      <div class="shell">
        <div class="section-heading reveal">
          <div>
            <p class="eyebrow">{t.standEyebrow}</p>
            <h2 class="display-title">{t.standTitle}</h2>
          </div>
          <p class="section-lead">
            {t.standLead}
          </p>
        </div>

        <div class="details-grid">
          <article class="detail-panel detail-panel-dark reveal">
            <header class="panel-head">
              <h3>{t.onSite}</h3>
              <span class="panel-index">01</span>
            </header>
            <ul class="equipment-list">
              {t.equipment.map((item) => (
                <li>
                  <Check size={17} stroke-width={2} aria-hidden="true" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </article>

          <article id="tarifs" class="detail-panel reveal">
            <header class="panel-head">
              <h3>{t.rentalRates}</h3>
              <span class="panel-index">02</span>
            </header>
            <dl class="price-list">
              {t.prices.map(([label, price]) => <div class="price-row"><dt>{label}</dt><dd>{price}</dd></div>)}
            </dl>
            <div class="price-notes">
              <span class="tag">{t.deposit}</span>
              <span class="tag tag-yellow">{t.memberDiscount}</span>
            </div>
            <div class="options-list" aria-label={t.optionsLabel}>
              {t.options.map(([label, price]) => <div class="option-item"><span>{label}</span><strong>{price}</strong></div>)}
            </div>
          </article>
        </div>
      </div>
    </section>

    <section id="galerie" class="section gallery-section" aria-labelledby="gallery-title">
      <div class="shell">
        <div class="section-heading gallery-heading reveal">
          <div>
            <p class="eyebrow">{t.galleryEyebrow}</p>
            <h2 id="gallery-title" class="display-title">{t.galleryTitle}</h2>
          </div>
          <p class="section-lead">
            {t.galleryLead}
          </p>
        </div>

        <h3 class="gallery-subtitle">{t.galleryEventTitle}</h3>
        <div class="gallery-grid reveal">
          <figure class="gallery-item gallery-item-tall">
            <img
              src="/event-exterieur-confidentiel.webp"
              width="852"
              height="1846"
              loading="lazy"
              decoding="async"
              alt={t.alts[11]}
            />
          </figure>
          <figure class="gallery-item gallery-item-wide">
            <img
              src="/event-ceremonie-confidentiel.webp"
              width="852"
              height="1846"
              loading="lazy"
              decoding="async"
              alt={t.alts[12]}
            />
          </figure>
          <figure class="gallery-item gallery-item-room">
            <img
              src="/event-salle-confidentiel.webp"
              width="852"
              height="1846"
              loading="lazy"
              decoding="async"
              alt={t.alts[13]}
            />
          </figure>
          <figure class="gallery-item gallery-item-detail">
            <img
              src="/event-decoration-confidentiel.webp"
              width="1086"
              height="1448"
              loading="lazy"
              decoding="async"
              alt={t.alts[14]}
            />
          </figure>
          <figure class="gallery-item gallery-item-banner">
            <img
              src="/event-fleurs.webp"
              width="900"
              height="1200"
              loading="lazy"
              decoding="async"
              alt={t.alts[15]}
            />
          </figure>
        </div>

      </div>
    </section>

    <section class="image-story" aria-label={t.locationLabel}>
      <figure>
        <img
          src="/stand.png"
          width="1200"
          height="900"
          loading="lazy"
          alt={t.alts[16]}
        />
      </figure>
      <div class="story-card">
        <div>
          <p class="eyebrow">{t.locationEyebrow}</p>
          <blockquote>{t.locationQuote}</blockquote>
        </div>
        <p>
          {t.locationCopy}
        </p>
      </div>
    </section>

    <section class="booking-band">
      <div class="booking-shell">
        <h2>{t.bookingBand}</h2>
        <a class="button" href={pagePaths.reservation[locale]}>
          {common.reserve}
          <ArrowUpRight size={18} stroke-width={1.8} aria-hidden="true" />
        </a>
      </div>
    </section>

    <section id="contact" class="section">
      <div class="shell">
        <div class="contact-intro reveal">
          <p class="eyebrow">{t.contactEyebrow}</p>
          <h2 class="display-title">{t.contactTitle}</h2>
        </div>
        <div class="contact-grid reveal">
          <article class="contact-card">
            <span class="contact-number">01</span>
            <h3>{t.managementTitle}</h3>
            <p><strong>{t.managerName}</strong><br />{t.managementCopy}</p>
            <a class="text-link" href="mailto:gerante@ads-preles.ch">
              gerante@ads-preles.ch
              <ArrowUpRight size={16} stroke-width={1.8} aria-hidden="true" />
            </a>
          </article>
          <article class="contact-card">
            <span class="contact-number">02</span>
            <h3>{t.phoneTitle}</h3>
            <p>{t.phoneCopy}</p>
            <a class="text-link" href="tel:+41786384791">
              <Phone size={16} stroke-width={1.8} aria-hidden="true" />
              078 638 47 91
            </a>
          </article>
          <article class="contact-card">
            <span class="contact-number">03</span>
            <h3>{t.accessTitle}</h3>
            <p>{t.accessCopy}</p>
            <a
              class="text-link"
              href="https://www.google.com/maps/search/?api=1&query=Stand+ADS+Prêles"
              target="_blank"
              rel="noopener noreferrer"
            >
              <MapPin size={16} stroke-width={1.8} aria-hidden="true" />
              {t.route}
            </a>
          </article>
        </div>
      </div>
    </section>
  </main>

  <dialog id="image-lightbox" class="image-lightbox" aria-label={t.photoDialog} data-expand-label={t.expand}>
    <button class="lightbox-close" type="button" aria-label={t.closePhoto}>
      <X size={30} stroke-width={1.7} aria-hidden="true" />
    </button>

    <button class="lightbox-nav lightbox-previous" type="button" aria-label={t.previousPhoto}>
      <ChevronLeft size={34} stroke-width={1.6} aria-hidden="true" />
    </button>

    <figure class="lightbox-figure">
      <img class="lightbox-image" src="" alt="" />
      <figcaption>
        <span class="lightbox-caption"></span>
        <span class="lightbox-counter" aria-live="polite"></span>
      </figcaption>
    </figure>

    <button class="lightbox-nav lightbox-next" type="button" aria-label={t.nextPhoto}>
      <ChevronRight size={34} stroke-width={1.6} aria-hidden="true" />
    </button>
  </dialog>

  <SiteFooter locale={locale} />
</MainLayout>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const elements = document.querySelectorAll<HTMLElement>('.reveal');

  if (reducedMotion || !('IntersectionObserver' in window)) {
    elements.forEach((element) => element.classList.add('visible'));
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.14 },
    );

    elements.forEach((element) => observer.observe(element));
  }

  const lightbox = document.querySelector<HTMLDialogElement>('#image-lightbox');
  const expandLabel = lightbox?.dataset.expandLabel ?? 'Agrandir';
  const lightboxImage = lightbox?.querySelector<HTMLImageElement>('.lightbox-image');
  const lightboxCaption = lightbox?.querySelector<HTMLElement>('.lightbox-caption');
  const lightboxCounter = lightbox?.querySelector<HTMLElement>('.lightbox-counter');
  const closeLightbox = lightbox?.querySelector<HTMLButtonElement>('.lightbox-close');
  const previousPhoto = lightbox?.querySelector<HTMLButtonElement>('.lightbox-previous');
  const nextPhoto = lightbox?.querySelector<HTMLButtonElement>('.lightbox-next');
  const galleryImages = Array.from(
    document.querySelectorAll<HTMLImageElement>(
      '.gallery-item img, .interior-photo img, .image-story figure img',
    ),
  );
  let currentPhoto = 0;

  const showPhoto = (index: number) => {
    if (!lightboxImage || !lightboxCaption || !lightboxCounter || galleryImages.length === 0) return;

    currentPhoto = (index + galleryImages.length) % galleryImages.length;
    const source = galleryImages[currentPhoto];
    lightboxImage.src = source.currentSrc || source.src;
    lightboxImage.alt = source.alt;
    lightboxCaption.textContent = source.alt;
    lightboxCounter.textContent = `${currentPhoto + 1} / ${galleryImages.length}`;
  };

  const openLightbox = (index: number) => {
    if (!lightbox) return;
    showPhoto(index);
    lightbox.showModal();
    document.body.classList.add('lightbox-open');
  };

  const closePhoto = () => {
    lightbox?.close();
  };

  galleryImages.forEach((image, index) => {
    const figure = image.closest<HTMLElement>('figure');
    if (!figure) return;

    figure.classList.add('is-expandable');
    figure.setAttribute('role', 'button');
    figure.setAttribute('tabindex', '0');
    figure.setAttribute('aria-haspopup', 'dialog');
    figure.setAttribute('aria-controls', 'image-lightbox');
    figure.dataset.expandLabel = expandLabel;
    figure.setAttribute('aria-label', `${expandLabel} : ${image.alt}`);
    figure.addEventListener('click', () => openLightbox(index));
    figure.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        openLightbox(index);
      }
    });
  });

  closeLightbox?.addEventListener('click', closePhoto);
  previousPhoto?.addEventListener('click', () => showPhoto(currentPhoto - 1));
  nextPhoto?.addEventListener('click', () => showPhoto(currentPhoto + 1));

  lightbox?.addEventListener('click', (event) => {
    if (event.target === lightbox) closePhoto();
  });

  lightbox?.addEventListener('close', () => {
    document.body.classList.remove('lightbox-open');
    if (lightboxImage) lightboxImage.src = '';
  });

  document.addEventListener('keydown', (event) => {
    if (!lightbox?.open) return;
    if (event.key === 'ArrowLeft') showPhoto(currentPhoto - 1);
    if (event.key === 'ArrowRight') showPhoto(currentPhoto + 1);
  });
</script>
