---
import { ArrowRight, ArrowUpRight, Check, MapPin } from '@lucide/astro';
import MainLayout from '../layouts/MainLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';

const title = 'Stand ADS Prêles — Location de salle au Plateau de Diesse';
const description =
  'Louez le Stand ADS à Prêles pour vos fêtes, repas et rencontres, jusqu’à 65 personnes.';

const equipment = [
  'Salle équipée jusqu’à 65 personnes',
  'Cuisine avec matériel de base',
  'Four à pizza disponible en option',
  'Cheminée et espace chaleureux',
  'Tables et bancs à disposition',
  'Vue dégagée sur le Chasseral',
];
---

<MainLayout title={title} description={description}>
  <SiteHeader active="home" />

  <main>
    <section class="home-hero" aria-labelledby="hero-title">
      <img
        class="hero-media"
        src="/stand.png"
        width="1600"
        height="900"
        alt="Le Stand ADS à Prêles et son environnement naturel"
        fetchpriority="high"
      />
      <div class="hero-shade" aria-hidden="true"></div>

      <div class="hero-main shell">
        <p class="kicker">Prêles · Plateau de Diesse</p>
        <h1 id="hero-title" class="hero-title">
          Un lieu simple<br />
          <em>pour se retrouver.</em>
        </h1>
        <p class="hero-copy">
          Une salle conviviale au cœur du Jura bernois, pensée pour vos repas,
          fêtes et rencontres jusqu’à 65 personnes.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="/reservation/">
            Préparer une réservation
            <ArrowRight size={18} stroke-width={1.8} aria-hidden="true" />
          </a>
          <a class="button button-ghost" href="#stand">Découvrir le lieu</a>
        </div>
      </div>

      <div class="hero-facts">
        <div class="facts-grid shell">
          <div class="fact"><strong>65</strong><span>personnes maximum</span></div>
          <div class="fact"><strong>23 h</strong><span>fin de location</span></div>
          <div class="fact"><strong>CHF 90</strong><span>tarif dès</span></div>
          <div class="fact"><strong>−20 %</strong><span>pour les membres ADS</span></div>
        </div>
      </div>
    </section>

    <section id="stand" class="section section-cream">
      <div class="shell">
        <div class="section-heading reveal">
          <div>
            <p class="eyebrow">Le stand</p>
            <h2 class="display-title">Tout ce qu’il faut.<br />Rien de superflu.</h2>
          </div>
          <p class="section-lead">
            Un espace fonctionnel et chaleureux, à l’écart du bruit, où l’on
            vient surtout pour partager un bon moment.
          </p>
        </div>

        <div class="details-grid">
          <article class="detail-panel detail-panel-dark reveal">
            <header class="panel-head">
              <h3>Sur place</h3>
              <span class="panel-index">01</span>
            </header>
            <ul class="equipment-list">
              {equipment.map((item) => (
                <li>
                  <Check size={17} stroke-width={2} aria-hidden="true" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </article>

          <article id="tarifs" class="detail-panel reveal">
            <header class="panel-head">
              <h3>Tarifs de location</h3>
              <span class="panel-index">02</span>
            </header>
            <dl class="price-list">
              <div class="price-row">
                <dt>Lundi–jeudi · journée ou soirée</dt>
                <dd>CHF 90.–</dd>
              </div>
              <div class="price-row">
                <dt>Lundi–jeudi · jour complet</dt>
                <dd>CHF 150.–</dd>
              </div>
              <div class="price-row">
                <dt>Week-end ou jour férié</dt>
                <dd>CHF 190.–</dd>
              </div>
              <div class="price-row">
                <dt>Dès 3 jours · par jour</dt>
                <dd>CHF 120.–</dd>
              </div>
            </dl>
            <div class="price-notes">
              <span class="tag">Caution non-membre · CHF 150.–</span>
              <span class="tag tag-yellow">Membres ADS · −20 %</span>
            </div>
            <div class="options-list" aria-label="Options disponibles">
              <div class="option-item"><span>Four à pizza</span><strong>+ CHF 50.–</strong></div>
              <div class="option-item"><span>Bois</span><strong>+ CHF 30.–</strong></div>
              <div class="option-item"><span>Nettoyage</span><strong>CHF 50.– / h</strong></div>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="image-story" aria-label="Situation du Stand ADS">
      <figure>
        <img
          src="/stand.png"
          width="1200"
          height="900"
          loading="lazy"
          alt="Vue du Stand ADS dans le paysage de Prêles"
        />
      </figure>
      <div class="story-card">
        <div>
          <p class="eyebrow">Au cœur du Jura bernois</p>
          <blockquote>Une vue ouverte sur le Chasseral, et du temps pour les autres.</blockquote>
        </div>
        <p>
          Le stand se trouve à Prêles, sur le Plateau de Diesse. Un cadre naturel
          et calme pour accueillir aussi bien une fête de famille qu’une rencontre
          d’association.
        </p>
      </div>
    </section>

    <section class="booking-band">
      <div class="booking-shell">
        <h2>Votre date. Votre événement. Notre stand.</h2>
        <a class="button" href="/reservation/">
          Voir la réservation
          <ArrowUpRight size={18} stroke-width={1.8} aria-hidden="true" />
        </a>
      </div>
    </section>

    <section id="contact" class="section">
      <div class="shell">
        <div class="contact-intro reveal">
          <p class="eyebrow">Contact</p>
          <h2 class="display-title">Une question&nbsp;?<br />Écrivez-nous.</h2>
        </div>
        <div class="contact-grid reveal">
          <article class="contact-card">
            <span class="contact-number">01</span>
            <h3>Réservation</h3>
            <p>Disponibilités, accès au stand et organisation de votre location.</p>
            <a class="text-link" href="mailto:gerante@ads-preles.ch">
              gerante@ads-preles.ch
              <ArrowUpRight size={16} stroke-width={1.8} aria-hidden="true" />
            </a>
          </article>
          <article class="contact-card">
            <span class="contact-number">02</span>
            <h3>Finances</h3>
            <p>Questions concernant un paiement, une facture ou la caution.</p>
            <a class="text-link" href="mailto:caisse@ads-preles.ch">
              caisse@ads-preles.ch
              <ArrowUpRight size={16} stroke-width={1.8} aria-hidden="true" />
            </a>
          </article>
          <article class="contact-card">
            <span class="contact-number">03</span>
            <h3>Accès</h3>
            <p>Stand ADS, 2515 Prêles, dans la commune du Plateau de Diesse.</p>
            <a
              class="text-link"
              href="https://www.google.com/maps/search/?api=1&query=Stand+ADS+Prêles"
              target="_blank"
              rel="noopener noreferrer"
            >
              <MapPin size={16} stroke-width={1.8} aria-hidden="true" />
              Ouvrir l’itinéraire
            </a>
          </article>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</MainLayout>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const elements = document.querySelectorAll<HTMLElement>('.reveal');

  if (reducedMotion || !('IntersectionObserver' in window)) {
    elements.forEach((element) => element.classList.add('visible'));
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.14 },
    );

    elements.forEach((element) => observer.observe(element));
  }
</script>
