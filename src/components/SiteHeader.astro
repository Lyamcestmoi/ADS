---
import { ArrowUpRight } from '@lucide/astro';

interface Props {
  active?: 'home' | 'reservation';
}

const { active = 'home' } = Astro.props;
---

<header class:list={['site-header', { 'site-header-home': active === 'home' }]}>
  <nav class="nav-shell" aria-label="Navigation principale">
    <a href="/" class="brand" aria-label="Stand ADS — Accueil">
      <img src="/logo.png" width="46" height="46" alt="" />
      <span>
        <strong>Stand ADS</strong>
        <small>Prêles · Plateau de Diesse</small>
      </span>
    </a>

    <div class="nav-links">
      <a href="/" class:list={{ active: active === 'home' }}>Accueil</a>
      <a href="/#stand">Le stand</a>
      <a href="/#tarifs">Tarifs</a>
      <a href="/#contact">Contact</a>
    </div>

    <a
      href="/reservation/"
      class:list={['nav-book', { active: active === 'reservation' }]}
    >
      Réserver
      <ArrowUpRight size={16} stroke-width={1.8} aria-hidden="true" />
    </a>
  </nav>
</header>

<script>
  const homeHeader = document.querySelector<HTMLElement>('.site-header-home');

  if (homeHeader) {
    const updateHeader = () => {
      homeHeader.classList.toggle('is-scrolled', window.scrollY > 32);
    };

    updateHeader();
    window.addEventListener('scroll', updateHeader, { passive: true });
  }
</script>
