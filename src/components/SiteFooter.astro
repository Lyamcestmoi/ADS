---
import { commonTranslations, pagePaths, type Locale } from '../lib/i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'fr' } = Astro.props;
const t = commonTranslations[locale];
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-shell">
    <div class="footer-brand">
      <img src="/logo.png" width="52" height="52" alt="" />
      <div>
        <strong>Stand ADS</strong>
        <span>{t.footerRental}</span>
      </div>
    </div>

    <div class="footer-links">
      <a href={pagePaths.home[locale]}>{t.home}</a>
      <a href={pagePaths.reservation[locale]}>{t.reserve}</a>
      <a href={pagePaths.accessibility[locale]}>{t.accessibility}</a>
      <a href="mailto:gerante@ads-preles.ch">{t.management}</a>
      <a
        href="https://www.leplateaudediesse.ch/locations-de-salles/Stand-ADS-Preles"
        target="_blank"
        rel="noopener noreferrer"
      >
        {t.municipalSite}
      </a>
    </div>

    <div class="footer-meta">
      <span>{t.footerPlace}</span>
      <span>© {year} Amicale Du Stand</span>
    </div>
  </div>
</footer>
